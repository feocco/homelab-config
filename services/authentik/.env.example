TZ=America/New_York
HOST_BIND_ADDR=127.0.0.1
AUTHENTIK_HTTP_PORT=9000
POSTGRES_DB=authentik
POSTGRES_USER=authentik
POSTGRES_PASSWORD=replace-with-runtime-secret
AUTHENTIK_SECRET_KEY=replace-with-runtime-secret
AUTHENTIK_BOOTSTRAP_EMAIL=joe@example.com
AUTHENTIK_BOOTSTRAP_PASSWORD_HASH=replace-with-django-password-hash
AUTHENTIK_DISABLE_UPDATE_CHECK=true
AUTHENTIK_ERROR_REPORTING__ENABLED=false
AUTHENTIK_OUTPOSTS__DISCOVER=false
AUTHENTIK_EMAIL__HOST=email-smtp.us-east-1.amazonaws.com
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=replace-with-runtime-secret
AUTHENTIK_EMAIL__PASSWORD=replace-with-runtime-secret
AUTHENTIK_EMAIL__FROM=Feocco Home <identity@example.com>
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__TIMEOUT=10
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret
PIRATE_RADIO_OIDC_CLIENT_ID=replace-with-runtime-client-id
PIRATE_RADIO_OIDC_CLIENT_SECRET=replace-with-runtime-client-secret
