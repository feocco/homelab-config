GRAFANA_ADMIN_USER=admin
HOST_BIND_ADDR=127.0.0.1
GRAFANA_HTTP_PORT=3000
GRAFANA_ROOT_URL=https://grafana.home.feocco.com/
GRAFANA_LOG_LEVEL=info
HOMELAB_FUNCTIONS_NOTIFY_URL=http://host.docker.internal:8091/v1/notify/joe
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_SCRAPE_INTERVAL=15s
TZ=America/New_York
DOCKER_STATS_EXPORTER_PORT=9109
DOCKER_STATS_EXPORTER_CACHE_TTL_SECONDS=15
OPENAI_COST_EXPORTER_PORT=9108
OPENAI_COST_CACHE_TTL_SECONDS=900
OPENAI_COST_DAILY_SPEND_SPIKE_THRESHOLD_USD=5
OPENAI_COST_7D_SPEND_HIGH_THRESHOLD_USD=30
OPENAI_COST_LOOKBACK_DAYS=30
OPENAI_COST_GROUP_BY=project_id,line_item
OPENAI_USAGE_COMPLETIONS_ENABLED=true
