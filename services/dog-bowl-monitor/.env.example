HA_URL=https://example.ui.nabu.casa
HA_LONG_LIVED_TOKEN=replace_me
OPENAI_API_KEY=replace_me
HOMELAB_FUNCTIONS_TOKEN=replace_me

TZ=America/New_York
SERVICE_PLATFORM=linux/arm64
HOST_BIND_ADDR=127.0.0.1
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8101
DATA_DIR=/app/data
LOG_LEVEL=INFO
