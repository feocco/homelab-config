TZ=America/New_York
SERVICE_PLATFORM=linux/amd64
LOG_LEVEL=INFO
HOST_BIND_ADDR=127.0.0.1
SERVICE_PORT=8106
# Non-secret identifiers for the read-only GitHub App
# feocco-waiting-dashboard-read. Private key: secret WAITING__DASHBOARD_GH_APP_KEY.
DASHBOARD_PUBLIC_URL=https://waiting.home.feocco.com
DASHBOARD_GH_APP_ID=5572135
DASHBOARD_GH_APP_INSTALLATION_ID=177648549
DASHBOARD_GH_OWNER=feocco
# Close-out (feocco/waiting#3). The write App is separate from the read-only
# inbox App: Issues write, Pull requests write, Metadata read. Fill in its ids
# once the App exists. Private key: secret WAITING__WAITING_CLOSER_GH_APP_KEY.
WAITING_CLOSER_GH_APP_ID=replace_me
WAITING_CLOSER_GH_APP_INSTALLATION_ID=replace_me
# Bot ledger (waiting-item-cancelled reports). Token: WAITING__HOMELAB_FUNCTIONS_TOKEN.
HOMELAB_FUNCTIONS_URL=http://host.docker.internal:8091
