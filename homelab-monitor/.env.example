GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_me
GRAFANA_HTTP_PORT=3000
GRAFANA_ROOT_URL=http://nasfeo:3000/
GRAFANA_LOG_LEVEL=info
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_SCRAPE_INTERVAL=15s
HOMELAB_FUNCTIONS_TOKEN=replace_me
OPENAI_ADMIN_KEY=replace_me
TZ=America/New_York
OPENAI_COST_EXPORTER_PORT=9108
OPENAI_COST_CACHE_TTL_SECONDS=900
OPENAI_COST_DAILY_SPEND_SPIKE_THRESHOLD_USD=5
OPENAI_COST_7D_SPEND_HIGH_THRESHOLD_USD=30
OPENAI_COST_LOOKBACK_DAYS=30
OPENAI_COST_GROUP_BY=project_id,line_item
OPENAI_USAGE_COMPLETIONS_ENABLED=true

# OpenAI cost collection requires an OpenAI Admin API key.
# The key needs the api.usage.read scope for organization usage/cost endpoints.
