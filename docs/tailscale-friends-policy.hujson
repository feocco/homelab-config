// Joe remains the owner of group membership. Replace the placeholder below
// with the exact login recorded after the alternate identity accepts its invite.
// A Gmail plus-address is not guaranteed to be a distinct Google identity.
{
  "groups": {
    "group:friends": [
      "joefeocco+tailscale-friend@gmail.com",
    ],
  },

  // Tailscale Services require every serving device to use a tag identity.
  "tagOwners": {
    "tag:homelab-service-host": ["autogroup:admin"],
  },

  "grants": [
    {
      "src": ["joefeocco@gmail.com", "tag:homelab-service-host"],
      "dst": ["*"],
      "ip": ["*"],
    },
    {
      "src": ["group:friends"],
      "dst": ["svc:authentik", "svc:pirate-radio"],
      "ip": ["tcp:443"],
    },
  ],
}
