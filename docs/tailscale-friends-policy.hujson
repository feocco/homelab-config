// Template ACL for friend-facing Tailscale Services.
// Keep the live policy in the Tailscale admin console; do not commit real
// friend emails or grants that map people to services.
//
// Replace placeholders below when applying in
// https://login.tailscale.com/admin/acls
{
  "groups": {
    "group:friends": [
      "friend@example.com",
    ],
  },

  // Tailscale Services require every serving device to use a tag identity.
  "tagOwners": {
    "tag:homelab-service-host": ["autogroup:admin"],
    "tag:cursor-cloud": ["autogroup:admin"],
  },

  "grants": [
    {
      "src": ["owner@example.com", "tag:homelab-service-host"],
      "dst": ["*"],
      "ip": ["*"],
    },
    {
      "src": ["group:friends"],
      "dst": ["svc:authentik", "svc:pirate-radio"],
      "ip": ["tcp:443"],
    },
    {
      "src": ["tag:cursor-cloud"],
      "dst": ["svc:stockfish-evaluator"],
      "ip": ["tcp:8096"],
    },
  ],

  "tests": [
    {
      "src": "tag:cursor-cloud",
      "accept": ["svc:stockfish-evaluator:8096"],
      "deny": [
        "svc:stockfish-evaluator:443",
        "svc:authentik:443",
        "svc:pirate-radio:443",
        "tag:homelab-service-host:8096",
      ],
    },
  ],
}
