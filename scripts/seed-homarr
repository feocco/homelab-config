#!/usr/bin/env python3
"""Seed Joe's Homarr app catalog and primary Homelab board.

This script intentionally reads the Homarr API key from an ignored .env file and
never prints it. It uses the public Homarr app REST API plus authenticated tRPC
board procedures exposed by the running Homarr instance.
"""

from __future__ import annotations

import argparse
import json
import os
import secrets
import string
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any


REPO_DIR = Path(__file__).resolve().parents[1]
DEFAULT_ENV_FILE = REPO_DIR / "services" / "homarr" / ".env"
DEFAULT_SEED_FILE = REPO_DIR / "services" / "homarr" / "seed" / "homelab.json"
DEFAULT_HOMARR_URL = "http://maclabs-mac-mini.taildf3445.ts.net:7575"
ID_ALPHABET = string.ascii_lowercase + string.digits


class HomarrError(RuntimeError):
    pass


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--apply", action="store_true", help="write changes to Homarr")
    parser.add_argument("--dry-run", action="store_true", help="show planned changes without writing")
    parser.add_argument("--url", help=f"Homarr base URL (default: HOMARR_URL or {DEFAULT_HOMARR_URL})")
    parser.add_argument("--env-file", type=Path, default=DEFAULT_ENV_FILE, help=f"env file with HOMARR_API_KEY (default: {DEFAULT_ENV_FILE})")
    parser.add_argument("--seed-file", type=Path, default=DEFAULT_SEED_FILE, help=f"seed JSON file (default: {DEFAULT_SEED_FILE})")
    args = parser.parse_args()

    if args.apply and args.dry_run:
        parser.error("--apply and --dry-run are mutually exclusive")
    dry_run = not args.apply

    env = load_env(args.env_file)
    api_key = env.get("HOMARR_API_KEY")
    if not api_key:
        raise HomarrError(f"HOMARR_API_KEY is missing from {args.env_file}")
    print(f"HOMARR_API_KEY present in {args.env_file} ({len(api_key)} chars)")

    homarr_url = (args.url or os.environ.get("HOMARR_URL") or env.get("HOMARR_URL") or DEFAULT_HOMARR_URL).rstrip("/")
    seed = json.loads(args.seed_file.read_text())
    client = HomarrClient(homarr_url, api_key)
    client.get("/api/openapi")
    print(f"Homarr API reachable at {client.base_url}/api/openapi")

    existing_apps = {app["name"]: app for app in client.get("/api/apps")}
    boards = client.trpc_query("board.search", {"query": "", "limit": 100})
    print(f"Current Homarr state: {len(existing_apps)} apps, {len(boards)} boards")

    desired_apps = flatten_apps(seed)
    print(f"Desired Homarr state: {len(desired_apps)} apps, board {seed['board']['name']!r}")
    for app in desired_apps:
        action = "update" if app["name"] in existing_apps else "create"
        print(f"  {action:6} app: {app['name']}")

    board = find_board(boards, seed["board"]["name"])
    if board:
        print(f"  update board: {seed['board']['name']}")
    else:
        print(f"  create board: {seed['board']['name']}")

    if dry_run:
        print("Dry run only. Re-run with --apply to write Homarr changes.")
        return 0

    app_ids = upsert_apps(client, existing_apps, desired_apps)
    board = ensure_board(client, seed)
    board = ensure_layouts(client, board, seed["board"]["columnCount"])
    board_payload = build_board_payload(board, seed, app_ids)
    client.trpc_mutation("board.saveBoard", board_payload)
    client.trpc_mutation("board.setHomeBoard", {"id": board["id"]})
    client.trpc_mutation("board.setMobileHomeBoard", {"id": board["id"]})
    print(f"Seeded board {seed['board']['name']!r} with {len(seed['sections'])} sections and {len(desired_apps)} apps")
    return 0


def load_env(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    if not path.exists():
        return values
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key] = value
    return values


def flatten_apps(seed: dict[str, Any]) -> list[dict[str, Any]]:
    apps: list[dict[str, Any]] = []
    seen: set[str] = set()
    for section in seed["sections"]:
        for app in section["apps"]:
            if app["name"] in seen:
                raise HomarrError(f"Duplicate app name in seed: {app['name']}")
            seen.add(app["name"])
            apps.append(app)
    return apps


def find_board(boards: list[dict[str, Any]], name: str) -> dict[str, Any] | None:
    return next((board for board in boards if board.get("name") == name), None)


def upsert_apps(
    client: "HomarrClient",
    existing_apps: dict[str, dict[str, Any]],
    desired_apps: list[dict[str, Any]],
) -> dict[str, str]:
    app_ids: dict[str, str] = {}
    for desired in desired_apps:
        payload = {
            "name": desired["name"],
            "description": desired.get("description"),
            "iconUrl": desired["iconUrl"],
            "href": desired.get("href"),
            "pingUrl": desired.get("pingUrl"),
        }
        existing = existing_apps.get(desired["name"])
        if existing:
            client.patch(f"/api/apps/{urllib.parse.quote(existing['id'])}", payload)
            app_ids[desired["name"]] = existing["id"]
            print(f"Updated app: {desired['name']}")
        else:
            created = client.post("/api/apps", payload)
            app_ids[desired["name"]] = created["id"]
            print(f"Created app: {desired['name']}")
    return app_ids


def ensure_board(client: "HomarrClient", seed: dict[str, Any]) -> dict[str, Any]:
    board_config = seed["board"]
    exists = client.trpc_query("board.exists", board_config["name"])
    if not exists:
        client.trpc_mutation(
            "board.createBoard",
            {
                "name": board_config["name"],
                "columnCount": board_config["columnCount"],
                "isPublic": board_config["isPublic"],
            },
        )
        print(f"Created board: {board_config['name']}")
    return client.trpc_query("board.getBoardByName", {"name": board_config["name"]})


def ensure_layouts(client: "HomarrClient", board: dict[str, Any], column_count: int) -> dict[str, Any]:
    layouts = board.get("layouts") or []
    updated = False
    new_layouts = []
    for layout in layouts:
        next_layout = dict(layout)
        if next_layout.get("columnCount") != column_count:
            next_layout["columnCount"] = column_count
            updated = True
        if not next_layout.get("name"):
            next_layout["name"] = "Base"
        new_layouts.append(next_layout)
    if not new_layouts:
        new_layouts = [{"id": random_id(), "name": "Base", "columnCount": column_count, "breakpoint": 0}]
        updated = True
    if updated:
        client.trpc_mutation("board.saveLayouts", {"id": board["id"], "layouts": new_layouts})
        print(f"Updated board layouts to {column_count} columns")
        return client.trpc_query("board.getBoardByName", {"name": board["name"]})
    return board


def build_board_payload(board: dict[str, Any], seed: dict[str, Any], app_ids: dict[str, str]) -> dict[str, Any]:
    layout_ids = [layout["id"] for layout in board["layouts"]]
    column_count = seed["board"]["columnCount"]
    board_config = seed["board"]
    tile_width = int(board_config.get("tileWidth", 1))
    tile_height = int(board_config.get("tileHeight", 1))
    description_display_mode = board_config.get("descriptionDisplayMode", "hidden")
    per_row = max(1, column_count // tile_width)
    sections: list[dict[str, Any]] = []
    items: list[dict[str, Any]] = []

    for section_index, section in enumerate(seed["sections"]):
        category_id = random_id()
        empty_id = random_id()
        category_y = section_index * 2
        empty_y = category_y + 1
        sections.append(
            {
                "id": category_id,
                "name": section["name"],
                "kind": "category",
                "yOffset": category_y,
                "xOffset": 0,
                "collapsed": False,
            }
        )
        sections.append({"id": empty_id, "kind": "empty", "yOffset": empty_y, "xOffset": 0})

        for app_index, app in enumerate(section["apps"]):
            app_id = app_ids[app["name"]]
            x_offset = (app_index % per_row) * tile_width
            y_offset = (app_index // per_row) * tile_height
            items.append(
                {
                    "id": random_id(),
                    "kind": "app",
                    "options": {
                        "appId": app_id,
                        "openInNewTab": True,
                        "showTitle": True,
                        "descriptionDisplayMode": app.get("descriptionDisplayMode", description_display_mode),
                        "layout": "column",
                        "pingEnabled": bool(app.get("pingEnabled")),
                    },
                    "layouts": [
                        {
                            "layoutId": layout_id,
                            "yOffset": y_offset,
                            "xOffset": x_offset,
                            "width": tile_width,
                            "height": tile_height,
                            "sectionId": empty_id,
                        }
                        for layout_id in layout_ids
                    ],
                    "integrationIds": [],
                    "advancedOptions": {
                        "title": None,
                        "customCssClasses": [],
                        "borderColor": "",
                    },
                }
            )

    return {"id": board["id"], "sections": sections, "items": items}


def random_id(length: int = 24) -> str:
    return "".join(secrets.choice(ID_ALPHABET) for _ in range(length))


class HomarrClient:
    def __init__(self, base_url: str, api_key: str) -> None:
        self.base_url = base_url
        self.api_key = api_key

    def get(self, path: str, params: dict[str, str] | None = None) -> Any:
        url = self._url(path, params)
        return self._request("GET", url)

    def post(self, path: str, body: dict[str, Any]) -> Any:
        return self._request("POST", self._url(path), body)

    def patch(self, path: str, body: dict[str, Any]) -> Any:
        return self._request("PATCH", self._url(path), body)

    def trpc_query(self, procedure: str, payload: Any) -> Any:
        params = {"input": json.dumps({"json": payload}, separators=(",", ":"))}
        response = self.get(f"/api/trpc/{procedure}", params)
        return unwrap_trpc(response)

    def trpc_mutation(self, procedure: str, payload: Any) -> Any:
        response = self._request("POST", self._url(f"/api/trpc/{procedure}"), {"json": payload})
        return unwrap_trpc(response)

    def _url(self, path: str, params: dict[str, str] | None = None) -> str:
        url = f"{self.base_url}{path}"
        if params:
            url = f"{url}?{urllib.parse.urlencode(params)}"
        return url

    def _request(self, method: str, url: str, body: dict[str, Any] | None = None) -> Any:
        data = None if body is None else json.dumps(body).encode()
        request = urllib.request.Request(url, data=data, method=method)
        request.add_header("ApiKey", self.api_key)
        request.add_header("Accept", "application/json")
        if body is not None:
            request.add_header("Content-Type", "application/json")
        try:
            with urllib.request.urlopen(request, timeout=20) as response:
                raw = response.read().decode()
        except urllib.error.HTTPError as exc:
            raw = exc.read().decode(errors="replace")
            raise HomarrError(f"{method} {redact_url(url)} failed with HTTP {exc.code}: {raw}") from exc
        except urllib.error.URLError as exc:
            raise HomarrError(f"{method} {redact_url(url)} failed: {exc}") from exc
        if not raw:
            return None
        payload = json.loads(raw)
        if isinstance(payload, dict) and "error" in payload:
            raise HomarrError(f"{method} {redact_url(url)} returned Homarr error: {payload['error']}")
        return payload


def unwrap_trpc(response: Any) -> Any:
    if not isinstance(response, dict):
        raise HomarrError(f"Unexpected tRPC response: {response!r}")
    if "error" in response:
        raise HomarrError(f"Homarr tRPC error: {response['error']}")
    try:
        return response["result"]["data"]["json"]
    except KeyError as exc:
        raise HomarrError(f"Unexpected tRPC response shape: {response!r}") from exc


def redact_url(url: str) -> str:
    parsed = urllib.parse.urlsplit(url)
    return urllib.parse.urlunsplit((parsed.scheme, parsed.netloc, parsed.path, "", ""))


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except HomarrError as exc:
        print(f"seed-homarr: {exc}", file=sys.stderr)
        raise SystemExit(1)
