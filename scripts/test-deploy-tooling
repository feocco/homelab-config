#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

HOMELAB_CONFIG_DIR="${REPO_DIR}" "${REPO_DIR}/scripts/homelab-deploy" --host nasfeo --list
HOMELAB_CONFIG_DIR="${REPO_DIR}" "${REPO_DIR}/scripts/homelab-deploy" --host nasfeo portainer --dry-run --deploy-base-dir "${REPO_DIR}"
HOMELAB_CONFIG_DIR="${REPO_DIR}" "${REPO_DIR}/scripts/homelab-deploy" --host nasfeo dashy-redirect --dry-run --deploy-base-dir "${REPO_DIR}"
HOMELAB_CONFIG_DIR="${REPO_DIR}" "${REPO_DIR}/scripts/homelab-deploy" --host nasfeo --all --dry-run --deploy-base-dir "${REPO_DIR}"
HOMELAB_CONFIG_DIR="${REPO_DIR}" "${REPO_DIR}/scripts/homelab-deploy" --host macmini --list
HOMELAB_CONFIG_DIR="${REPO_DIR}" "${REPO_DIR}/scripts/homelab-deploy" --host macmini plant-monitor --dry-run --deploy-base-dir "${REPO_DIR}"
"${REPO_DIR}/scripts/render-service-env" --host nasfeo --all --base-dir "${REPO_DIR}" --deploy-base-dir "${REPO_DIR}" --dry-run >/dev/null
"${REPO_DIR}/scripts/render-service-env" --host macmini plant-monitor --base-dir "${REPO_DIR}" --deploy-base-dir "${REPO_DIR}" --dry-run >/dev/null
"${REPO_DIR}/scripts/apply-tailscale-serve" --host macmini --base-dir "${REPO_DIR}" --dry-run >/dev/null
"${REPO_DIR}/scripts/ensure-macmini-node-exporter" --dry-run >/dev/null
bash -n "${REPO_DIR}/scripts/check-macmini-monitor-health"
python3 - \
  "${REPO_DIR}/services/homelab-monitor/exporters/openai_cost_exporter.py" \
  "${REPO_DIR}/services/homelab-monitor/exporters/docker_stats_exporter.py" <<'PY'
import ast
import pathlib
import sys

for arg in sys.argv[1:]:
    ast.parse(pathlib.Path(arg).read_text(), filename=arg)
PY
tmp_runtime="$(mktemp -d)"
mkdir -p "${tmp_runtime}/legacy-service/data" "${tmp_runtime}/services/legacy-service/data"
touch "${tmp_runtime}/services/legacy-service/data/.gitkeep"
echo "state" > "${tmp_runtime}/legacy-service/data/state.txt"
rm -rf "${tmp_runtime}/services/legacy-service/data"
mkdir -p "${tmp_runtime}/services/legacy-service/data"
touch "${tmp_runtime}/services/legacy-service/data/.gitkeep"
rm -rf "${tmp_runtime}/services/legacy-service/data"
"${REPO_DIR}/scripts/migrate-host-runtime-layout" "${tmp_runtime}" >/dev/null
test -f "${tmp_runtime}/services/legacy-service/data/state.txt"
rm -rf "${tmp_runtime}"
"${REPO_DIR}/scripts/check-service-secrets" --base-dir "${REPO_DIR}"

if grep -R '\${{ github.event.inputs\.' "${REPO_DIR}/.github/workflows"; then
  echo "Deploy workflows must not interpolate github.event.inputs directly into shell scripts." >&2
  exit 1
fi

echo "Deploy tooling checks passed."
