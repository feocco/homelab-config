#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

HOMELAB_CONFIG_DIR="${REPO_DIR}" "${REPO_DIR}/scripts/homelab-deploy" --host nasfeo --list
HOMELAB_CONFIG_DIR="${REPO_DIR}" "${REPO_DIR}/scripts/homelab-deploy" --host nasfeo portainer --dry-run --deploy-base-dir "${REPO_DIR}"
HOMELAB_CONFIG_DIR="${REPO_DIR}" "${REPO_DIR}/scripts/homelab-deploy" --host nasfeo dashy-redirect --dry-run --deploy-base-dir "${REPO_DIR}"
HOMELAB_CONFIG_DIR="${REPO_DIR}" "${REPO_DIR}/scripts/homelab-deploy" --host nasfeo --all --dry-run --deploy-base-dir "${REPO_DIR}"
HOMELAB_CONFIG_DIR="${REPO_DIR}" "${REPO_DIR}/scripts/homelab-deploy" --host macmini --list
HOMELAB_CONFIG_DIR="${REPO_DIR}" "${REPO_DIR}/scripts/homelab-deploy" --host macmini plant-monitor --dry-run --deploy-base-dir "${REPO_DIR}"
"${REPO_DIR}/scripts/render-service-env" --host nasfeo --all --base-dir "${REPO_DIR}" --deploy-base-dir "${REPO_DIR}" --dry-run >/dev/null
"${REPO_DIR}/scripts/render-service-env" --host macmini plant-monitor --base-dir "${REPO_DIR}" --deploy-base-dir "${REPO_DIR}" --dry-run >/dev/null
"${REPO_DIR}/scripts/apply-tailscale-serve" --host macmini --base-dir "${REPO_DIR}" --dry-run >/dev/null
"${REPO_DIR}/scripts/ensure-macmini-node-exporter" --dry-run >/dev/null
bash -n "${REPO_DIR}/scripts/check-macmini-monitor-health"
python3 - \
  "${REPO_DIR}/services/homelab-monitor/exporters/openai_cost_exporter.py" \
  "${REPO_DIR}/services/homelab-monitor/exporters/docker_stats_exporter.py" <<'PY'
import ast
import pathlib
import sys

for arg in sys.argv[1:]:
    ast.parse(pathlib.Path(arg).read_text(), filename=arg)
PY
tmp_runtime="$(mktemp -d)"
mkdir -p "${tmp_runtime}/legacy-service/data" "${tmp_runtime}/services/legacy-service/data"
touch "${tmp_runtime}/services/legacy-service/data/.gitkeep"
echo "state" > "${tmp_runtime}/legacy-service/data/state.txt"
rm -rf "${tmp_runtime}/services/legacy-service/data"
mkdir -p "${tmp_runtime}/services/legacy-service/data"
touch "${tmp_runtime}/services/legacy-service/data/.gitkeep"
rm -rf "${tmp_runtime}/services/legacy-service/data"
"${REPO_DIR}/scripts/migrate-host-runtime-layout" "${tmp_runtime}" >/dev/null
test -f "${tmp_runtime}/services/legacy-service/data/state.txt"
rm -rf "${tmp_runtime}"

guard_tmp="$(mktemp -d)"
guard_repo="${guard_tmp}/repo"
guard_runtime="${guard_tmp}/runtime"
guard_fakebin="${guard_tmp}/bin"
mkdir -p \
  "${guard_repo}/scripts" \
  "${guard_repo}/hosts/macmini" \
  "${guard_repo}/services/demo" \
  "${guard_runtime}/services/demo" \
  "${guard_fakebin}"
cp "${REPO_DIR}/scripts/homelab-deploy" "${guard_repo}/scripts/homelab-deploy"
cp "${REPO_DIR}/scripts/lib-service-secrets" "${guard_repo}/scripts/lib-service-secrets"
chmod +x "${guard_repo}/scripts/homelab-deploy"
cat > "${guard_repo}/hosts/macmini/services.yaml" <<EOF
host:
  name: macmini
  deploy_base_dir: ${guard_runtime}

services:
  demo:
    path: services/demo
    enabled: true
EOF
cat > "${guard_runtime}/services/demo/docker-compose.yml" <<'EOF'
services:
  demo:
    image: ghcr.io/feocco/demo:latest
EOF
cat > "${guard_fakebin}/docker-compose" <<EOF
#!/usr/bin/env bash
printf '%s\n' "\$*" >> "${guard_tmp}/compose.log"
EOF
cat > "${guard_fakebin}/docker" <<'EOF'
#!/usr/bin/env bash
if [ "$1" = "ps" ]; then
  echo "CONTAINER ID   IMAGE   NAMES"
  exit 0
fi
exit 0
EOF
chmod +x "${guard_fakebin}/docker-compose" "${guard_fakebin}/docker"
(
  cd "${guard_repo}"
  git init >/dev/null
  git checkout -b main >/dev/null
  git config user.email "test@example.invalid"
  git config user.name "Deploy Tooling Test"
  git add .
  git commit -m "initial" >/dev/null
)
touch "${guard_repo}/dirty.txt"
if PATH="${guard_fakebin}:$PATH" HOMELAB_CONFIG_DIR="${guard_repo}" \
  "${guard_repo}/scripts/homelab-deploy" --host macmini demo --deploy-base-dir "${guard_runtime}" >"${guard_tmp}/dirty.out" 2>&1; then
  echo "Dirty non-dry-run deploy should fail." >&2
  exit 1
fi
grep -q "dirty worktree" "${guard_tmp}/dirty.out"
PATH="${guard_fakebin}:$PATH" HOMELAB_CONFIG_DIR="${guard_repo}" \
  "${guard_repo}/scripts/homelab-deploy" --host macmini demo --allow-dirty --deploy-base-dir "${guard_runtime}" >/dev/null
grep -q '"git_dirty": true' "${guard_runtime}/.homelab-deploy-state/macmini/demo.json"
grep -q -- '--remove-orphans' "${guard_tmp}/compose.log"
rm -f "${guard_repo}/dirty.txt" "${guard_tmp}/compose.log"
(
  cd "${guard_repo}"
  git checkout -b feature/canary >/dev/null
)
if PATH="${guard_fakebin}:$PATH" HOMELAB_CONFIG_DIR="${guard_repo}" \
  "${guard_repo}/scripts/homelab-deploy" --host macmini demo --deploy-base-dir "${guard_runtime}" >"${guard_tmp}/branch.out" 2>&1; then
  echo "Non-main deploy without --canary should fail." >&2
  exit 1
fi
grep -q "without --canary" "${guard_tmp}/branch.out"
PATH="${guard_fakebin}:$PATH" HOMELAB_CONFIG_DIR="${guard_repo}" \
  "${guard_repo}/scripts/homelab-deploy" --host macmini demo --canary --deploy-base-dir "${guard_runtime}" >/dev/null
grep -q '"canary": true' "${guard_runtime}/.homelab-deploy-state/macmini/demo.json"
(
  cd "${guard_repo}"
  git checkout main >/dev/null
)
PATH="${guard_fakebin}:$PATH" HOMELAB_CONFIG_DIR="${guard_repo}" \
  "${guard_repo}/scripts/homelab-deploy" --host macmini demo --deploy-base-dir "${guard_runtime}" >/dev/null
grep -q '"git_branch": "main"' "${guard_runtime}/.homelab-deploy-state/macmini/demo.json"
rm -rf "${guard_tmp}"
"${REPO_DIR}/scripts/check-service-secrets" --base-dir "${REPO_DIR}"

if grep -R '\${{ github.event.inputs\.' "${REPO_DIR}/.github/workflows"; then
  echo "Deploy workflows must not interpolate github.event.inputs directly into shell scripts." >&2
  exit 1
fi

for planner_service in \
  bedtime \
  caddy \
  dashy \
  dashy-redirect \
  dog-bowl-monitor \
  hass-janitor \
  hello-nas \
  homarr \
  homelab-functions \
  homelab-log-watcher \
  homelab-monitor \
  homelab-sre-agent \
  instacart-history-service \
  mealie \
  mealie-planner \
  plant-monitor \
  portainer
do
  "${REPO_DIR}/scripts/homelab-plan" --service "${planner_service}" --base-ref HEAD --json >/dev/null
done

planner_tmp="$(mktemp -d)"
planner_repo="${planner_tmp}/repo"
mkdir -p \
  "${planner_repo}/hosts/macmini" \
  "${planner_repo}/services/demo" \
  "${planner_repo}/../demo-app/demo_app" \
  "${planner_repo}/../demo-app/tests"
cat > "${planner_repo}/hosts/macmini/services.yaml" <<'EOF'
host:
  name: macmini
  deploy_base_dir: ${HOME}/homelab-config-runtime

services:
  demo:
    path: services/demo
    enabled: true
EOF
cat > "${planner_repo}/homelab-deploy-policy.yaml" <<EOF
services:
  demo:
    host: macmini
    path: services/demo
    source:
      repo: feocco/demo
      path_hint: ${planner_tmp}/demo-app
    default_strategy: direct
    smoke_checks:
      - curl -fsS http://127.0.0.1:8080/health
    restore:
      required_for:
        - data/**
        - migrations/**
EOF
cat > "${planner_repo}/../demo-app/homelab.yaml" <<'EOF'
service: demo
image: ghcr.io/feocco/demo
health:
  url: http://127.0.0.1:8080/health
checks:
  - python -m pytest
risk:
  default: direct
  canary:
    - docker-compose.yml
  restore:
    - data/**
EOF
touch "${planner_repo}/services/demo/.env.config"
touch "${planner_repo}/services/demo/docker-compose.yml"
touch "${planner_repo}/../demo-app/demo_app/main.py"
touch "${planner_repo}/../demo-app/tests/test_main.py"
(
  cd "${planner_repo}/../demo-app"
  git init >/dev/null
  git checkout -b main >/dev/null
  git config user.email "test@example.invalid"
  git config user.name "Deploy Planner Test"
  git add .
  git commit -m "initial" >/dev/null
)
(
  cd "${planner_repo}"
  git init >/dev/null
  git checkout -b main >/dev/null
  git config user.email "test@example.invalid"
  git config user.name "Deploy Planner Test"
  git add .
  git commit -m "initial" >/dev/null
)
echo "# source change" >> "${planner_repo}/../demo-app/demo_app/main.py"
planner_direct="$("${REPO_DIR}/scripts/homelab-plan" --base-dir "${planner_repo}" --service demo --base-ref HEAD --json)"
echo "${planner_direct}" | python3 -c 'import json,sys; payload=json.load(sys.stdin); assert payload["strategy"] == "direct"; assert "python -m pytest" in payload["checks"]'
planner_missing_ref="$("${REPO_DIR}/scripts/homelab-plan" --base-dir "${planner_repo}" --service demo --base-ref missing-ref --json)"
echo "${planner_missing_ref}" | python3 -c 'import json,sys; payload=json.load(sys.stdin); assert payload["warnings"]; assert payload["strategy"] == "direct"'
(
  cd "${planner_repo}/../demo-app"
  git add demo_app/main.py
  git commit -m "source change" >/dev/null
)
echo "# compose change" >> "${planner_repo}/services/demo/docker-compose.yml"
planner_canary="$("${REPO_DIR}/scripts/homelab-plan" --base-dir "${planner_repo}" --service demo --base-ref HEAD --json)"
echo "${planner_canary}" | python3 -c 'import json,sys; payload=json.load(sys.stdin); assert payload["strategy"] == "canary"; assert any("--canary" in command for command in payload["deploy_commands"])'
(
  cd "${planner_repo}"
  git add services/demo/docker-compose.yml
  git commit -m "compose change" >/dev/null
)
mkdir -p "${planner_repo}/services/demo/data"
echo "state" > "${planner_repo}/services/demo/data/state.json"
planner_restore="$("${REPO_DIR}/scripts/homelab-plan" --base-dir "${planner_repo}" --service demo --base-ref HEAD --json)"
echo "${planner_restore}" | python3 -c 'import json,sys; payload=json.load(sys.stdin); assert payload["strategy"] == "restore"; assert payload["restore_required"] is True'
rm -rf "${planner_tmp}"

echo "Deploy tooling checks passed."
