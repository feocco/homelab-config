#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
source "${REPO_DIR}/scripts/tests/lib-test-helpers"

test -f "${REPO_DIR}/mkdocs.yml"
assert_contains "${REPO_DIR}/mkdocs.yml" "material"
assert_contains "${REPO_DIR}/mkdocs.yml" "Home: index.md"
assert_contains "${REPO_DIR}/mkdocs.yml" "generated/service-index.md"
assert_contains "${REPO_DIR}/mkdocs.yml" "docs/docs-site.md"
assert_contains "${REPO_DIR}/mkdocs.yml" "services/caddy/README.md"
if grep -q "services/homepage/README.md" "${REPO_DIR}/mkdocs.yml"; then
  echo "Application-specific service pages should come from generated service docs links, not static MkDocs nav." >&2
  exit 1
fi
assert_contains "${REPO_DIR}/mkdocs.yml" "mermaid"

test -f "${REPO_DIR}/docs/requirements.txt"
assert_contains "${REPO_DIR}/docs/requirements.txt" "mkdocs-material"
test -f "${REPO_DIR}/docs/docs-site.md"
assert_contains "${REPO_DIR}/docs/docs-site.md" "scripts/build-docs-site"
assert_contains "${REPO_DIR}/docs/docs-site.md" "docs/generated/service-index.md"
assert_contains "${REPO_DIR}/docs/docs-site.md" ".local/mkdocs-src"
assert_contains "${REPO_DIR}/docs/docs-site.md" ".site/"
assert_contains "${REPO_DIR}/docs/docs-site.md" "http://127.0.0.1:8765/"
assert_contains "${REPO_DIR}/docs/docs-site.md" "https://docs.home.feocco.com"
assert_contains "${REPO_DIR}/docs/docs-site.md" "GitHub Pages"
assert_contains "${REPO_DIR}/docs/docs-site.md" "docs_path"
assert_contains "${REPO_DIR}/docs/docs-site.md" "openapi_path"
assert_contains "${REPO_DIR}/docs/docs-site.md" "api_framework"
test -f "${REPO_DIR}/.github/workflows/docs.yml"
assert_contains "${REPO_DIR}/.github/workflows/docs.yml" "github-pages"
assert_contains "${REPO_DIR}/.github/workflows/docs.yml" "scripts/build-docs-site"
assert_contains "${REPO_DIR}/.gitignore" "docs/generated/*"
assert_contains "${REPO_DIR}/.gitignore" "!docs/generated/.gitkeep"

tmpdir="$(mktemp -d)"
"${REPO_DIR}/scripts/generate-docs-service-index" --output "${tmpdir}/service-index.md"
assert_contains "${tmpdir}/service-index.md" "# Service Index"
assert_contains "${tmpdir}/service-index.md" "Generated from"
assert_contains "${tmpdir}/service-index.md" "## By Domain"
assert_contains "${tmpdir}/service-index.md" "## Service API Convention"
assert_contains "${tmpdir}/service-index.md" "## By Host And Status"
assert_contains "${tmpdir}/service-index.md" "Plant Monitor"
assert_contains "${tmpdir}/service-index.md" "macmini"
assert_contains "${tmpdir}/service-index.md" "Runtime Services"
assert_contains "${tmpdir}/service-index.md" "https://plant-monitor.home.feocco.com/"
assert_contains "${tmpdir}/service-index.md" "Service docs:"
assert_contains "${tmpdir}/service-index.md" "https://hello-nas.home.feocco.com/docs"
assert_contains "${tmpdir}/service-index.md" 'OpenAPI: `/openapi.json`'
assert_contains "${tmpdir}/service-index.md" 'Framework: `python-http-server`'
assert_contains "${tmpdir}/service-index.md" "Not migrated yet"
assert_contains "${tmpdir}/service-index.md" "Migrate these active services separately"
assert_contains "${tmpdir}/service-index.md" "Pirate Radio"
rm -rf "${tmpdir}"

"${REPO_DIR}/scripts/generate-docs-service-index" --output "${REPO_DIR}/docs/generated/service-index.md"
test -f "${REPO_DIR}/docs/generated/service-index.md"
if git -C "${REPO_DIR}" ls-files --error-unmatch docs/generated/service-index.md >/dev/null 2>&1; then
  echo "Generated docs service index must not be tracked." >&2
  exit 1
fi

assert_contains "${REPO_DIR}/services/homelab-docs/ops.yaml" "dashboard_name: Homelab Docs"
assert_contains "${REPO_DIR}/services/homelab-docs/ops.yaml" "route_hostname: docs.home.feocco.com"

if python3 -m mkdocs --version >/dev/null 2>&1; then
  "${REPO_DIR}/scripts/build-docs-site" --site-dir "${tmpdir}/site"
fi
