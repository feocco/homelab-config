#!/usr/bin/env bash
# Deploy and check paths emit {"event","slug","stage","outcome","ms"}.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
source "${REPO_DIR}/scripts/tests/lib-test-helpers"
# shellcheck source=../lib-deploy-event-log
source "${REPO_DIR}/scripts/lib-deploy-event-log"

assert_event_object() {
  local line="$1"
  python3 - "${line}" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
keys = set(payload)
expected = {"event", "slug", "stage", "outcome", "ms"}
if keys != expected:
    raise SystemExit(f"event keys {sorted(keys)} != {sorted(expected)}")
ms = payload["ms"]
if isinstance(ms, bool) or not isinstance(ms, int) or ms < 0:
    raise SystemExit(f"ms {ms!r} is not a non-negative int")
for field in ("event", "slug", "stage", "outcome"):
    value = payload[field]
    if not isinstance(value, str) or not value:
        raise SystemExit(f"{field} must be a non-empty string")
PY
}

sample="$(mktemp)"
log_deploy_event deploy demo compose-up ok 15 2>"${sample}"
sample_line="$(cat "${sample}")"
assert_event_object "${sample_line}"
python3 - "${sample_line}" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
expected = {
    "event": "deploy",
    "slug": "demo",
    "stage": "compose-up",
    "outcome": "ok",
    "ms": 15,
}
if payload != expected:
    raise SystemExit(f"sample event {payload} != {expected}")
PY
rm -f "${sample}"

if log_deploy_event deploy demo compose-up ok -1 2>/dev/null; then
  echo "A negative ms must be rejected." >&2
  exit 1
fi

grep -q 'log_deploy_event check ' "${REPO_DIR}/scripts/test-deploy-tooling"
grep -q 'log_deploy_event deploy ' "${REPO_DIR}/scripts/homelab-deploy"

dry_out="$(mktemp)"
dry_err="$(mktemp)"
list_err="$(mktemp)"
prep_tmp=""
cleanup_event_check() {
  rm -f "${dry_out}" "${dry_err}" "${list_err}"
  if [[ -n "${prep_tmp}" ]]; then
    rm -rf "${prep_tmp}"
  fi
}
trap cleanup_event_check EXIT

"${REPO_DIR}/scripts/homelab-deploy" --host macmini caddy --dry-run --deploy-base-dir "${REPO_DIR}" >"${dry_out}" 2>"${dry_err}"
assert_contains "${dry_out}" "Would generate Caddy config"

python3 - "${dry_err}" <<'PY'
import json
import pathlib
import sys

lines = [line for line in pathlib.Path(sys.argv[1]).read_text().splitlines() if line.strip()]
if not lines:
    raise SystemExit("dry-run deploy produced no event lines")
events = []
for line in lines:
    try:
        payload = json.loads(line)
    except json.JSONDecodeError as error:
        raise SystemExit(f"dry-run stderr is not one JSON event per line: {line}") from error
    keys = set(payload)
    if keys != {"event", "slug", "stage", "outcome", "ms"}:
        raise SystemExit(f"event keys {sorted(keys)}")
    if payload["event"] != "deploy" or payload["slug"] != "caddy":
        raise SystemExit(f"unexpected deploy event {payload}")
    if isinstance(payload["ms"], bool) or not isinstance(payload["ms"], int) or payload["ms"] < 0:
        raise SystemExit(f"ms {payload['ms']!r} is not a non-negative int")
    events.append((payload["stage"], payload["outcome"]))

expected = [
    ("config-validate", "skip"),
    ("prepare", "dry-run"),
    ("image-pull", "skip"),
    ("compose-up", "skip"),
]
if events != expected:
    raise SystemExit(f"dry-run stages {events} != {expected}")
PY

"${REPO_DIR}/scripts/homelab-deploy" --host macmini --list >/dev/null 2>"${list_err}"
if grep -q '"event":"deploy"' "${list_err}"; then
  echo "--list must not emit deploy events." >&2
  cat "${list_err}" >&2
  exit 1
fi

# Every generated prepare step must stop a real deploy when it fails. Each
# fixture is a clean main checkout, so no deploy guard is skipped.
prep_tmp="$(mktemp -d)"
real_python3="$(command -v python3)"
assert_prepare_failure_stops_deploy() {
  local service="$1"
  local failing="$2"
  shift 2
  local repo="${prep_tmp}/${service}-${failing}"
  local out="${repo}.out"
  local passing
  mkdir -p "${repo}/scripts" "${repo}/hosts/nasfeo" "${repo}/services/${service}" "${repo}/bin"
  cp "${REPO_DIR}/scripts/homelab-deploy" "${repo}/scripts/homelab-deploy"
  cp "${REPO_DIR}/scripts/lib-service-secrets" "${repo}/scripts/lib-service-secrets"
  cp "${REPO_DIR}/scripts/lib-deploy-event-log" "${repo}/scripts/lib-deploy-event-log"
  cat > "${repo}/hosts/nasfeo/services.yaml" <<EOF
host:
  name: nasfeo

services:
  ${service}:
    path: services/${service}
    enabled: true
EOF
  cat > "${repo}/services/${service}/docker-compose.yml" <<EOF
services:
  ${service}:
    image: ${service}:fixture
EOF
  for passing in "$@"; do
    printf '#!/usr/bin/env bash\nexit 0\n' > "${repo}/scripts/${passing}"
  done
  printf '#!/usr/bin/env bash\necho "fixture %s failed" >&2\nexit 1\n' "${failing}" > "${repo}/scripts/${failing}"
  # Report mkdocs as installed so homelab-docs reaches build-docs-site without a venv or network.
  printf '#!/usr/bin/env bash\n[[ "$*" == "-m mkdocs --version" ]] && exit 0\nexec "%s" "$@"\n' "${real_python3}" > "${repo}/bin/python3"
  chmod +x "${repo}/scripts/"* "${repo}/bin/python3"
  (
    cd "${repo}"
    git init >/dev/null 2>&1
    git checkout -b main >/dev/null 2>&1
    git config user.email "test@example.invalid"
    git config user.name "Deploy Tooling Test"
    git add .
    git commit -m "initial" >/dev/null
  )
  if PATH="${repo}/bin:${PATH}" HOMELAB_CONFIG_DIR="${repo}" \
    "${repo}/scripts/homelab-deploy" --host nasfeo "${service}" --deploy-base-dir "${repo}" \
    >"${out}" 2>&1; then
    echo "A failed ${failing} must stop the ${service} deploy." >&2
    cat "${out}" >&2
    exit 1
  fi
  assert_contains "${out}" "fixture ${failing} failed"
  python3 - "${out}" "${service}" "${failing}" <<'PY'
import json
import pathlib
import sys

out, service, failing = sys.argv[1:]
events = []
for line in pathlib.Path(out).read_text().splitlines():
    line = line.strip()
    if not line.startswith("{"):
        continue
    try:
        payload = json.loads(line)
    except json.JSONDecodeError:
        continue
    if payload.get("event") == "deploy":
        events.append((payload.get("slug"), payload.get("stage"), payload.get("outcome")))

if (service, "prepare", "fail") not in events:
    raise SystemExit(f"{service}: prepare fail event missing after {failing} failed: {events}")
continued = [item for item in events if item[1] in {"image-pull", "compose-up", "provenance"}]
if continued:
    raise SystemExit(f"{service}: deploy continued after {failing} failed: {continued}")
PY
  if [[ -e "${repo}/.homelab-deploy-state/nasfeo/${service}.json" ]]; then
    echo "A failed ${failing} must not write ${service} deploy provenance." >&2
    exit 1
  fi
}

assert_prepare_failure_stops_deploy caddy generate-caddy-config
assert_prepare_failure_stops_deploy homepage generate-homepage-config
assert_prepare_failure_stops_deploy homelab-functions generate-service-catalog generate-smoke-signal-config
assert_prepare_failure_stops_deploy homelab-functions generate-smoke-signal-config generate-service-catalog
assert_prepare_failure_stops_deploy homelab-docs build-docs-site
rm -rf "${prep_tmp}"

echo "deploy event log: ok"
