#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
tmp_dir="$(mktemp -d)"
trap 'rm -rf "${tmp_dir}"' EXIT

"${REPO_DIR}/scripts/generate-smoke-signal-config" --output "${tmp_dir}"

python3 - "${tmp_dir}/smoke-signal-targets.json" <<'PY'
import json
import pathlib
import sys

payload = json.loads(pathlib.Path(sys.argv[1]).read_text())

if payload["schema"] != "homelab-smoke-signal-targets.v1":
    raise SystemExit("Unexpected Smoke Signal target schema")

critical = {target["service"]: target for target in payload["critical_canaries"]}
for service in ("homelab-monitor", "homepage", "homelab-functions"):
    if service not in critical:
        raise SystemExit(f"Missing critical Smoke Signal canary: {service}")
    if not critical[service]["url"].startswith("https://"):
        raise SystemExit(f"Critical canary should use routed HTTPS URL: {service}")

runtime = {target["service"]: target for target in payload["runtime_services"]}
for service in ("plant-monitor", "hass-janitor", "homelab-sre-agent"):
    if service not in runtime:
        raise SystemExit(f"Missing runtime Smoke Signal target: {service}")
    if "/health" not in runtime[service]["url"]:
        raise SystemExit(f"Runtime target should use health path: {service}")

if "homelab-smoke-signal" in runtime:
    raise SystemExit("Smoke Signal should not monitor itself as a Mac runtime service")
PY

if git -C "${REPO_DIR}" ls-files --error-unmatch services/homelab-functions/config/smoke-signal-targets.json >/dev/null 2>&1; then
  echo "Generated Smoke Signal targets must not be tracked." >&2
  exit 1
fi

if git -C "${REPO_DIR}" ls-files --error-unmatch services/homelab-functions/config/service-catalog.json >/dev/null 2>&1; then
  echo "Generated service catalog must not be tracked." >&2
  exit 1
fi

deploy_dry_run="$("${REPO_DIR}/scripts/homelab-deploy" --host macmini homelab-functions --dry-run --deploy-base-dir "${REPO_DIR}")"
if [[ "${deploy_dry_run}" != *"Would generate Homelab Functions catalog config"* ]]; then
  echo "homelab-functions dry-run should show deploy-time catalog generation" >&2
  echo "${deploy_dry_run}" >&2
  exit 1
fi

smoke_dry_run="$("${REPO_DIR}/scripts/homelab-deploy" --host nasfeo homelab-smoke-signal --dry-run --deploy-base-dir "${REPO_DIR}")"
if [[ "${smoke_dry_run}" != *"Would remove legacy homelab-sentinel container if present"* ]]; then
  echo "homelab-smoke-signal dry-run should show legacy container cleanup" >&2
  echo "${smoke_dry_run}" >&2
  exit 1
fi

echo "Smoke Signal config checks passed."
