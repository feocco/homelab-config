#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
source "${REPO_DIR}/scripts/tests/lib-test-helpers"

catalog_json="$(mktemp)"
"${REPO_DIR}/scripts/generate-service-catalog" --format json >"${catalog_json}"
python3 - "${catalog_json}" <<'PY'
import json
import pathlib
import sys

payload = json.loads(pathlib.Path(sys.argv[1]).read_text())
services = {(row["service"], row["host"]): row for row in payload["services"]}

for key in [
    ("plant-monitor", "macmini"),
    ("homelab-monitor", "macmini"),
    ("portainer", "nasfeo"),
    ("dashy", "macmini"),
    ("homarr", "macmini"),
    ("homepage", "macmini"),
]:
    if key not in services:
        raise SystemExit(f"Missing catalog service: {key}")

if services[("plant-monitor", "macmini")]["source_repo"] != "feocco/plant-monitor":
    raise SystemExit("plant-monitor source_repo should come from ops/SRE metadata")
if services[("plant-monitor", "macmini")]["monitoring"] is not True:
    raise SystemExit("plant-monitor should show monitoring enabled")
if services[("homelab-monitor", "macmini")]["kind"] != "multi-container":
    raise SystemExit("homelab-monitor kind should come from ops.yaml")
if services[("portainer", "nasfeo")]["kind"] != "infra":
    raise SystemExit("portainer kind should come from ops.yaml")
if services[("dashy", "macmini")]["enabled"] is not False:
    raise SystemExit("dashy should be disabled after Homepage cutover")
if services[("homarr", "macmini")]["enabled"] is not True:
    raise SystemExit("homarr should remain enabled and separate")
if services[("homepage", "macmini")]["homepage_url"] != "https://home.feocco.com/":
    raise SystemExit("homepage should use home.feocco.com as its primary URL")
if services[("plant-monitor", "macmini")]["dashboard_description"] != "Home Assistant plant notifications":
    raise SystemExit("plant-monitor dashboard metadata should come from ops.yaml")
if services[("plant-monitor", "macmini")]["dashboard_group"] != "Runtime Services":
    raise SystemExit("plant-monitor dashboard group should come from ops.yaml")
if services[("homepage", "macmini")]["dashboard_icon"] != "homepage.png":
    raise SystemExit("homepage dashboard icon should come from ops.yaml")
PY
rm -f "${catalog_json}"

inventory_json="$(mktemp)"
"${REPO_DIR}/scripts/list-homelab-services" --format json >"${inventory_json}"
python3 - "${inventory_json}" <<'PY'
import json
import pathlib
import sys

rows = json.loads(pathlib.Path(sys.argv[1]).read_text())
services = {(row["service"], row["host"]): row for row in rows}

if services[("dashy", "macmini")]["enabled"] is not False:
    raise SystemExit("list-homelab-services should show dashy disabled on macmini")
if services[("homepage", "macmini")]["enabled"] is not True:
    raise SystemExit("list-homelab-services should show homepage enabled on macmini")
if services[("homarr", "macmini")]["enabled"] is not True:
    raise SystemExit("list-homelab-services should show homarr still enabled")
if services[("homepage", "macmini")]["source_repo"] != "feocco/homelab-config":
    raise SystemExit("homepage source_repo should be catalog-derived")
PY
rm -f "${inventory_json}"

homepage_tmp="$(mktemp -d)"
"${REPO_DIR}/scripts/generate-homepage-config" --output "${homepage_tmp}"
assert_contains "${homepage_tmp}/settings.yaml" 'title: Homelab'
assert_contains "${homepage_tmp}/services.yaml" 'Daily Ops'
assert_contains "${homepage_tmp}/services.yaml" 'Infrastructure'
assert_contains "${homepage_tmp}/services.yaml" 'Runtime Services'
assert_contains "${homepage_tmp}/services.yaml" 'Monitoring & Cost'
assert_contains "${homepage_tmp}/services.yaml" 'Disabled / Legacy'
assert_contains "${homepage_tmp}/services.yaml" 'Plant Monitor'
assert_contains "${homepage_tmp}/services.yaml" 'Home Assistant plant notifications'
assert_contains "${homepage_tmp}/services.yaml" 'OpenAI Cost / Usage'
assert_contains "${homepage_tmp}/services.yaml" 'Homarr'
assert_contains "${homepage_tmp}/services.yaml" 'http://homarr.home.arpa/'
assert_contains "${homepage_tmp}/services.yaml" 'Dashy'
assert_contains "${homepage_tmp}/services.yaml" 'https://home.feocco.com/'
assert_contains "${homepage_tmp}/services.yaml" 'AWS Console'
assert_contains "${homepage_tmp}/services.yaml" 'Prusa Connect'
test -f "${homepage_tmp}/service-catalog.json"
rm -rf "${homepage_tmp}"

tracked_generated="$(git -C "${REPO_DIR}" ls-files 'services/homepage/config/*.yaml' 'services/homepage/config/*.json')"
if [[ -n "${tracked_generated}" ]]; then
  echo "Generated Homepage config must not be tracked:" >&2
  echo "${tracked_generated}" >&2
  exit 1
fi

assert_contains "${REPO_DIR}/services/homepage/manual-links.yaml" 'AWS Console'
deploy_dry_run="$("${REPO_DIR}/scripts/homelab-deploy" --host macmini homepage --dry-run --deploy-base-dir "${REPO_DIR}")"
if [[ "${deploy_dry_run}" != *"Would generate Homepage config"* ]]; then
  echo "Homepage dry-run should show deploy-time config generation" >&2
  echo "${deploy_dry_run}" >&2
  exit 1
fi
"${REPO_DIR}/scripts/validate-service-rollout" --service homepage --host macmini --check config --mode strict
