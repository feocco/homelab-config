#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
source "${REPO_DIR}/scripts/tests/lib-test-helpers"

validate_discovered_manifests() {
  local found="false"
  local manifest service host hosts_file enabled_file

  while IFS= read -r manifest; do
    found="true"
    service="$(basename "$(dirname "${manifest}")")"
    hosts_file="$(mktemp)"
    python3 - "${manifest}" >"${hosts_file}" <<'PY'
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
in_hosts = False
for raw in path.read_text().splitlines():
    line = raw.rstrip()
    if line.startswith("host:"):
        print(line.split(":", 1)[1].strip())
        in_hosts = False
        continue
    if line == "hosts:":
        in_hosts = True
        continue
    if in_hosts:
        if line.startswith("  - "):
            print(line[4:].strip())
        elif line and not line.startswith(" "):
            in_hosts = False
PY
    if [[ ! -s "${hosts_file}" ]]; then
      echo "${manifest} is missing host/hosts; validator should report that directly." >&2
      rm -f "${hosts_file}"
      exit 1
    fi

    while IFS= read -r host; do
      [[ -n "${host}" ]] || continue
      enabled_file="$(mktemp)"
      python3 - "${REPO_DIR}/hosts/${host}/services.yaml" "${service}" >"${enabled_file}" <<'PY'
import pathlib
import re
import sys

path = pathlib.Path(sys.argv[1])
service = sys.argv[2]
enabled = None
current = ""
for raw in path.read_text().splitlines():
    line = raw.rstrip()
    match = re.match(r"^  ([^:\s][^:]*):\s*$", line)
    if match:
        current = match.group(1)
        if current == service:
            enabled = True
        continue
    if current == service:
        match = re.match(r"^    enabled:\s*(.+)\s*$", line)
        if match:
            enabled = match.group(1).strip().lower() != "false"
print("true" if enabled else "false")
PY
      if ! grep -qx "true" "${enabled_file}"; then
        echo "Skipping disabled service rollout manifest: ${service} on ${host}"
        rm -f "${enabled_file}"
        continue
      fi
      rm -f "${enabled_file}"
      "${REPO_DIR}/scripts/validate-service-rollout" \
        --service "${service}" \
        --host "${host}" \
        --check config \
        --mode strict

      if grep -q '^live_base_url:' "${manifest}"; then
        "${REPO_DIR}/scripts/validate-service-rollout" \
          --service "${service}" \
          --host "${host}" \
          --check live \
          --mode smoketest
      fi
    done <"${hosts_file}"
    rm -f "${hosts_file}"
  done < <(find "${REPO_DIR}/services" -maxdepth 2 -name ops.yaml | sort)

  if [[ "${found}" != "true" ]]; then
    echo "No services/*/ops.yaml manifests found to validate." >&2
    exit 1
  fi
}

