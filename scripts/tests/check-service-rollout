copy_fixture() {
  local destination="$1"
  mkdir -p "${destination}"
  tar \
    --exclude='.git' \
    --exclude='.homelab-deploy-state' \
    --exclude='services/*/data/*' \
    -cf - . | tar -xf - -C "${destination}"
}

missing_out="$(mktemp)"
assert_fails "${missing_out}" "${REPO_DIR}/scripts/validate-service-rollout" --service missing-demo --host macmini --check config --mode strict
assert_contains "${missing_out}" 'Missing service rollout manifest'
assert_contains "${missing_out}" 'services/missing-demo/ops.yaml'
rm -f "${missing_out}"

validate_discovered_manifests

validator_tmp="$(mktemp -d)"
trap 'rm -rf "${validator_tmp}"' EXIT
validator_fixture="${validator_tmp}/repo"
copy_fixture "${validator_fixture}"
add_validator_demo_fixture "${validator_fixture}"
add_worker_demo_fixture "${validator_fixture}"
add_multi_container_demo_fixture "${validator_fixture}"
add_multihost_demo_fixture "${validator_fixture}"

if "${validator_fixture}/scripts/validate-service-rollout" --base-dir "${validator_fixture}" --service validator-demo --host macmini --check config --mode strict >"${validator_tmp}/baseline.out" 2>&1; then
  :
else
  cat "${validator_tmp}/baseline.out" >&2
  echo "validator-demo fixture baseline should pass." >&2
  exit 1
fi
for fixture_case in \
  "validator-worker macmini" \
  "validator-multi macmini" \
  "validator-multihost macmini" \
  "validator-multihost nasfeo"; do
  read -r fixture_service fixture_host <<<"${fixture_case}"
  if "${validator_fixture}/scripts/validate-service-rollout" --base-dir "${validator_fixture}" --service "${fixture_service}" --host "${fixture_host}" --check config --mode strict >"${validator_tmp}/${fixture_service}-${fixture_host}.out" 2>&1; then
    :
  else
    cat "${validator_tmp}/${fixture_service}-${fixture_host}.out" >&2
    echo "${fixture_service} fixture baseline should pass on ${fixture_host}." >&2
    exit 1
  fi
done

cp -R "${validator_fixture}" "${validator_tmp}/invalid-manifest"
python3 - "${validator_tmp}/invalid-manifest/services/validator-demo/ops.yaml" <<'PY'
