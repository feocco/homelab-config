#!/usr/bin/env python3
"""ADR 0002 isolation guard for Authentik forward-auth services.

A forward-auth app trusts X-Authentik-* headers, so the only path to it must be
Caddy. For every service listed in ADR 0002 (which must equal the set of
services with route_auth: authentik_forward_auth) the Compose file must:
  - publish ports only on 127.0.0.1 (literal, no variable bind address),
  - not use network_mode (host or otherwise),
  - define exactly one service and no `networks:`, so the container sits alone
    on its own project default network.
"""
import pathlib
import re
import sys

import yaml

REPO = pathlib.Path(sys.argv[1] if len(sys.argv) > 1 else pathlib.Path(__file__).resolve().parents[2])
ADR = REPO / "docs/adr/0002-never-implement-custom-auth.md"
errors: list[str] = []

section = re.search(r"^## Services using forward auth\n(.*?)(?=^## |\Z)", ADR.read_text(), re.M | re.S)
listed = set(re.findall(r"^- `([a-z0-9-]+)`", section.group(1), re.M)) if section else set()
if not section:
    errors.append(
        "ADR 0002 has no '## Services using forward auth' section. "
        "Fix: add that section to docs/adr/0002-never-implement-custom-auth.md "
        "and list every authentik_forward_auth service."
    )
declared = {
    ops.parent.name
    for ops in REPO.glob("services/*/ops.yaml")
    if re.search(r"^route_auth:\s*authentik_forward_auth\s*$", ops.read_text(), re.M)
}
for name in sorted(declared - listed):
    errors.append(
        f"{name}: uses authentik_forward_auth but is not listed in ADR 0002. "
        f"Fix: add `{name}` under '## Services using forward auth' in "
        "docs/adr/0002-never-implement-custom-auth.md."
    )
for name in sorted(listed - declared):
    errors.append(
        f"{name}: listed in ADR 0002 but its route is not authentik_forward_auth. "
        f"Fix: set route_auth: authentik_forward_auth in services/{name}/ops.yaml, "
        f"or remove `{name}` from that ADR list."
    )

for name in sorted(listed | declared):
    compose_path = REPO / "services" / name / "docker-compose.yml"
    if not compose_path.exists():
        errors.append(
            f"{name}: no docker-compose.yml. "
            f"Fix: add services/{name}/docker-compose.yml that publishes ports only on 127.0.0.1."
        )
        continue
    compose = yaml.safe_load(compose_path.read_text()) or {}
    services = compose.get("services") or {}
    if len(services) != 1:
        errors.append(
            f"{name}: compose must define exactly one service (found {len(services)}). "
            f"Fix: keep a single service in services/{name}/docker-compose.yml and do not join extra networks."
        )
    if compose.get("networks"):
        errors.append(
            f"{name}: compose must not define or join networks. "
            f"Fix: delete the networks key from services/{name}/docker-compose.yml."
        )
    for svc_name, svc in services.items():
        if "network_mode" in svc:
            errors.append(
                f"{name}/{svc_name}: network_mode is not allowed. "
                "Fix: remove network_mode so the container stays on its own project network, reachable only through Caddy."
            )
        if svc.get("networks"):
            errors.append(
                f"{name}/{svc_name}: must not join networks. "
                f"Fix: remove networks from the service in services/{name}/docker-compose.yml."
            )
        for port in svc.get("ports") or []:
            text = port if isinstance(port, str) else f"{port.get('host_ip', '')}:"
            if not str(text).startswith("127.0.0.1:"):
                errors.append(
                    f"{name}/{svc_name}: port '{port}' must bind literally to 127.0.0.1. "
                    "Fix: publish it as 127.0.0.1:HOST:CONTAINER with no variable bind address."
                )
        if svc.get("expose"):
            errors.append(
                f"{name}/{svc_name}: expose is not allowed. "
                f"Fix: remove expose from services/{name}/docker-compose.yml."
            )

# Forged identity headers: Caddy must strip every client X-Authentik-* header
# before any handler runs, on every forward-auth host.
sys.path.insert(0, str(REPO / "scripts" / "lib"))
import homelab_catalog  # noqa: E402

caddyfile = homelab_catalog.caddy_config(REPO)
for name in sorted(listed & declared):
    host = re.search(r"^route_hostname:\s*(\S+)", (REPO / "services" / name / "ops.yaml").read_text(), re.M).group(1)
    block = re.search(rf"^{re.escape(host)} {{\n(.*?)^}}", caddyfile, re.M | re.S)
    if not block:
        errors.append(
            f"{name}: no Caddy site block for {host}. "
            "Fix: set route_hostname and route_auth: authentik_forward_auth so "
            "./scripts/generate-caddy-config emits the site. Do not hand-edit the Caddyfile."
        )
        continue
    body = block.group(1)
    first_handle = body.find("\thandle")
    for header in homelab_catalog.AUTHENTIK_IDENTITY_HEADERS:
        strip = body.find(f"\trequest_header -{header}\n")
        if strip < 0 or (first_handle >= 0 and strip > first_handle):
            errors.append(
                f"{name}: Caddy does not strip client {header} before handlers. "
                f"Fix: keep the generated site stripping {header} before any handle block. "
                "Change route_* fields and regenerate. Do not hand-edit the Caddyfile."
            )
    if "forward_auth" not in body:
        errors.append(
            f"{name}: Caddy block has no forward_auth. "
            "Fix: set route_auth: authentik_forward_auth and regenerate Caddy. "
            "Do not add a custom auth path."
        )

if errors:
    print("\n".join(errors), file=sys.stderr)
    sys.exit(1)
print(f"idp isolation: ok ({', '.join(sorted(listed))})")
