#!/usr/bin/env python3
"""Fixture tests for scripts/check-workflow-policy."""

from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path


REPO_DIR = Path(__file__).resolve().parents[2]
VALIDATOR = REPO_DIR / "scripts" / "check-workflow-policy"
FIXTURE_DIR = REPO_DIR / "scripts" / "tests" / "fixtures" / "workflow-policy"
DISPATCH_FIXTURE_DIR = (
    REPO_DIR / "scripts" / "tests" / "fixtures" / "workflow-policy-dispatch"
)
EXPECTED_REPOSITORY = "feocco/example"


def run_validator(
    workflows_dir: Path, repository: str, deploy_workflow: str | None = None
) -> subprocess.CompletedProcess[str]:
    command = [
        sys.executable,
        str(VALIDATOR),
        "--workflows-dir",
        str(workflows_dir),
        "--repository",
        repository,
    ]
    if deploy_workflow is not None:
        command.extend(["--deploy-workflow", deploy_workflow])
    return subprocess.run(
        command,
        check=False,
        text=True,
        capture_output=True,
    )


def assert_finding(output: str, path: str, rule: str, text: str) -> None:
    expected = f".github/workflows/{path}: [{rule}]"
    if expected not in output or text not in output:
        raise AssertionError(
            f"missing fixture finding {expected!r} containing {text!r}:\n{output}"
        )


def assert_warning(output: str, path: str, rule: str, text: str) -> None:
    expected = f".github/workflows/{path}: warning: [{rule}]"
    if expected not in output or text not in output:
        raise AssertionError(
            f"missing fixture warning {expected!r} containing {text!r}:\n{output}"
        )


fixture_result = run_validator(
    FIXTURE_DIR / ".github" / "workflows",
    EXPECTED_REPOSITORY,
    ".github/workflows/deploy-no-guard.yml",
)
if fixture_result.returncode != 1:
    raise AssertionError(
        f"unsafe fixtures should fail with status 1, got {fixture_result.returncode}:\n"
        f"{fixture_result.stdout}{fixture_result.stderr}"
    )

fixture_output = fixture_result.stdout + fixture_result.stderr
if "Workflow policy failed with 15 finding(s)." not in fixture_output:
    raise AssertionError(f"unsafe fixtures should produce exactly 15 findings:\n{fixture_output}")
assert_finding(
    fixture_output,
    "unsafe-direct.yml",
    "untrusted-runner",
    "pull_request, pull_request_target",
)
assert_finding(
    fixture_output,
    "unsafe-matrix.yml",
    "untrusted-runner",
    "protected runner label(s) self-hosted",
)
assert_finding(
    fixture_output,
    "unsafe-dynamic.yml",
    "untrusted-runner",
    "cannot be proven GitHub-hosted",
)
assert_finding(
    fixture_output,
    "unsafe-chain.yml",
    "untrusted-runner",
    "reachable from pull_request",
)
assert_finding(
    fixture_output,
    "called.yml",
    "untrusted-runner",
    "issue_comment, pull_request_review, pull_request_review_comment",
)
assert_finding(
    fixture_output,
    "unsafe-fork.yml",
    "untrusted-runner",
    "reachable from fork",
)
assert_finding(
    fixture_output,
    "unsafe-issues-opened.yml",
    "untrusted-runner",
    "reachable from issues",
)
assert_finding(
    fixture_output,
    "unsafe-watch.yml",
    "untrusted-runner",
    "reachable from watch",
)
assert_finding(
    fixture_output,
    "unsafe-unpinned-action.yml",
    "action-pin",
    "someone/action@main",
)
assert_finding(
    fixture_output,
    "missing-guard.yml",
    "repository-guard",
    "protected runner label(s) self-hosted",
)
assert_finding(
    fixture_output,
    "guard-bypass.yml",
    "repository-guard",
    "protected runner label(s) self-hosted",
)
assert_finding(
    fixture_output,
    "deploy-no-guard.yml",
    "repository-guard",
    "explicitly configured deploy workflow",
)
assert_finding(
    fixture_output,
    "missing-permissions.yml",
    "permissions",
    "must declare read-only defaults",
)
assert_finding(
    fixture_output,
    "write-default.yml",
    "permissions",
    "elevate per job",
)
assert_finding(
    fixture_output,
    "write-mixed-dispatch.yml",
    "permissions",
    "elevate per job",
)
for passing_fixture in (
    "action-pin-exemptions.yml",
    "call-only-workflow-run.yml",
    "job-elevation.yml",
):
    if f"{passing_fixture}:" in fixture_output:
        raise AssertionError(
            f"{passing_fixture} should not produce a finding:\n{fixture_output}"
        )

issues_fixture = (
    FIXTURE_DIR / ".github" / "workflows" / "unsafe-issues-opened.yml"
).read_text()
if "types: [opened]" not in issues_fixture:
    raise AssertionError("issues fixture must exercise the issues: opened trigger")

dispatch_result = run_validator(
    DISPATCH_FIXTURE_DIR / ".github" / "workflows",
    EXPECTED_REPOSITORY,
)
if dispatch_result.returncode != 0:
    raise AssertionError(
        f"dispatch-only write permissions should warn without failing:\n"
        f"{dispatch_result.stdout}{dispatch_result.stderr}"
    )
dispatch_output = dispatch_result.stdout + dispatch_result.stderr
for dispatch_fixture in (
    "write-repository-dispatch.yml",
    "write-workflow-dispatch.yml",
):
    assert_warning(
        dispatch_output,
        dispatch_fixture,
        "permissions",
        "elevate per job",
    )
if "Workflow policy passed for 2 workflow(s) with 2 warning(s)." not in dispatch_output:
    raise AssertionError(
        f"dispatch-only fixtures should produce exactly two warnings:\n{dispatch_output}"
    )

repo_result = run_validator(
    REPO_DIR / ".github" / "workflows",
    "feocco/homelab-config",
    ".github/workflows/deploy.yml",
)
if repo_result.returncode != 0:
    raise AssertionError(
        f"current repository workflows should pass:\n"
        f"{repo_result.stdout}{repo_result.stderr}"
    )

gate_text = (REPO_DIR / ".github" / "workflows" / "workflow-policy.yml").read_text()
action_refs = re.findall(r"\buses:\s*\S+@([^\s#]+)", gate_text)
if not action_refs or any(
    re.fullmatch(r"[0-9a-f]{40}", reference) is None for reference in action_refs
):
    raise AssertionError("Workflow Policy actions must be pinned to full commit SHAs")
if "runs-on: ubuntu-latest" not in gate_text or "runs-on: self-hosted" in gate_text:
    raise AssertionError("Workflow Policy must use GitHub-hosted runners only")
if "--deploy-workflow .github/workflows/deploy.yml" not in gate_text:
    raise AssertionError("Workflow Policy must explicitly identify deploy.yml")
if "pip install --require-hashes -r scripts/requirements-workflow-policy.txt" not in gate_text:
    raise AssertionError("Workflow Policy must require hashes when installing PyYAML")

requirements_text = (REPO_DIR / "scripts" / "requirements-workflow-policy.txt").read_text()
if (
    "PyYAML==6.0.3" not in requirements_text
    or requirements_text.count("--hash=sha256:") < 2
):
    raise AssertionError("PyYAML must be pinned with hashes for supported Python wheels")

codeowners_text = (REPO_DIR / "CODEOWNERS").read_text().splitlines()
for required_entry in (
    "/.github/workflows/ @feocco",
    "/scripts/check-workflow-policy @feocco",
):
    if required_entry not in codeowners_text:
        raise AssertionError(f"CODEOWNERS must include {required_entry!r}")

print("Workflow policy fixture checks passed.")
