#!/usr/bin/env python3
"""Fixture tests for scripts/check-workflow-policy."""

from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

import yaml


REPO_DIR = Path(__file__).resolve().parents[2]
VALIDATOR = REPO_DIR / "scripts" / "check-workflow-policy"
FIXTURE_DIR = REPO_DIR / "scripts" / "tests" / "fixtures" / "workflow-policy"
EXPECTED_REPOSITORY = "feocco/example"


def run_validator(
    workflows_dir: Path, repository: str, deploy_workflow: str
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [
            sys.executable,
            str(VALIDATOR),
            "--workflows-dir",
            str(workflows_dir),
            "--repository",
            repository,
            "--deploy-workflow",
            deploy_workflow,
        ],
        check=False,
        text=True,
        capture_output=True,
    )


def assert_finding(output: str, path: str, rule: str, text: str) -> None:
    expected = f".github/workflows/{path}: [{rule}]"
    if expected not in output or text not in output:
        raise AssertionError(
            f"missing fixture finding {expected!r} containing {text!r}:\n{output}"
        )


fixture_result = run_validator(
    FIXTURE_DIR / ".github" / "workflows",
    EXPECTED_REPOSITORY,
    ".github/workflows/deploy-no-guard.yml",
)
if fixture_result.returncode != 1:
    raise AssertionError(
        f"unsafe fixtures should fail with status 1, got {fixture_result.returncode}:\n"
        f"{fixture_result.stdout}{fixture_result.stderr}"
    )

fixture_output = fixture_result.stdout + fixture_result.stderr
if "Workflow policy failed with 16 finding(s)." not in fixture_output:
    raise AssertionError(f"unsafe fixtures should produce exactly 16 findings:\n{fixture_output}")
assert_finding(
    fixture_output,
    "unsafe-direct.yml",
    "untrusted-runner",
    "pull_request, pull_request_target",
)
assert_finding(
    fixture_output,
    "unsafe-matrix.yml",
    "untrusted-runner",
    "protected runner label(s) self-hosted",
)
assert_finding(
    fixture_output,
    "unsafe-dynamic.yml",
    "untrusted-runner",
    "cannot be proven GitHub-hosted",
)
assert_finding(
    fixture_output,
    "unsafe-chain.yml",
    "untrusted-runner",
    "reachable from pull_request",
)
assert_finding(
    fixture_output,
    "called.yml",
    "untrusted-runner",
    "issue_comment, pull_request_review, pull_request_review_comment",
)
for fixture_name, event_name in (
    ("unsafe-fork.yml", "fork"),
    ("unsafe-issue-comment.yml", "issue_comment"),
    ("unsafe-issues.yml", "issues"),
    ("unsafe-watch.yml", "watch"),
):
    assert_finding(
        fixture_output,
        fixture_name,
        "untrusted-runner",
        f"reachable from {event_name}",
    )
assert_finding(
    fixture_output,
    "missing-guard.yml",
    "repository-guard",
    "protected runner label(s) self-hosted",
)
assert_finding(
    fixture_output,
    "guard-bypass.yml",
    "repository-guard",
    "protected runner label(s) self-hosted",
)
assert_finding(
    fixture_output,
    "deploy-no-guard.yml",
    "repository-guard",
    "explicitly configured deploy workflow",
)
assert_finding(
    fixture_output,
    "missing-permissions.yml",
    "permissions",
    "must declare read-only defaults",
)
assert_finding(
    fixture_output,
    "write-default.yml",
    "permissions",
    "elevate per job",
)
assert_finding(
    fixture_output,
    "dispatch-write-default.yml",
    "permissions",
    "grant write permissions per job",
)
assert_finding(
    fixture_output,
    "unpinned-third-party-action.yml",
    "action-pin",
    "someone/action@main",
)
for passing_fixture in (
    "call-only-workflow-run.yml",
    "guard-with-always.yml",
    "job-elevation.yml",
    "preflight-main.yml",
):
    if f"{passing_fixture}:" in fixture_output:
        raise AssertionError(
            f"{passing_fixture} should not produce a finding:\n{fixture_output}"
        )

preflight_as_deploy = run_validator(
    FIXTURE_DIR / ".github" / "workflows",
    EXPECTED_REPOSITORY,
    ".github/workflows/preflight-main.yml",
)
preflight_output = preflight_as_deploy.stdout + preflight_as_deploy.stderr
if "preflight-main.yml:" in preflight_output:
    raise AssertionError(
        "a preflight job on push to main and workflow_dispatch must stay allowed "
        "when the self-hosted deploy job needs it:\n"
        f"{preflight_output}"
    )

repo_result = run_validator(
    REPO_DIR / ".github" / "workflows",
    "feocco/homelab-config",
    ".github/workflows/deploy.yml",
)
if repo_result.returncode != 0:
    raise AssertionError(
        f"current repository workflows should pass:\n"
        f"{repo_result.stdout}{repo_result.stderr}"
    )

PREFLIGHT_COMMAND = "LC_ALL=C ./scripts/test-deploy-tooling --offline"
STATUS_OVERRIDE = re.compile(r"\b(?:always|failure|cancelled)\s*\(")


def runner_labels(job: dict) -> set[str]:
    runs_on = job.get("runs-on")
    if isinstance(runs_on, str):
        return {runs_on}
    if isinstance(runs_on, list):
        return {str(label) for label in runs_on}
    return set()


def preflight_gate_errors(deploy_text: str) -> list[str]:
    workflow = yaml.safe_load(deploy_text) or {}
    errors: list[str] = []
    triggers = workflow.get("on", workflow.get(True)) or {}
    if isinstance(triggers, str):
        triggers = {triggers: None}
    elif isinstance(triggers, list):
        triggers = {event: None for event in triggers}
    if {"pull_request", "pull_request_target"} & set(triggers):
        errors.append(
            "deploy.yml must stay on push to main and workflow_dispatch so preflight "
            "cannot reach a self-hosted runner from pull_request"
        )
    jobs = workflow.get("jobs") or {}
    preflight = jobs.get("preflight")
    if not isinstance(preflight, dict):
        return errors + [
            "deploy.yml must keep a preflight job for push to main and workflow_dispatch"
        ]
    if preflight.get("runs-on") != "ubuntu-latest":
        errors.append("deploy.yml preflight must run on ubuntu-latest")
    if "github.repository == 'feocco/homelab-config'" not in str(preflight.get("if", "")):
        errors.append(
            "deploy.yml preflight is inside the deploy workflow and must keep the repository guard"
        )
    steps = [step for step in preflight.get("steps") or [] if isinstance(step, dict)]
    if not any(str(step.get("run", "")).strip() == PREFLIGHT_COMMAND for step in steps):
        errors.append(
            f"deploy.yml preflight must run exactly `{PREFLIGHT_COMMAND}` so a failed check fails the job"
        )
    if preflight.get("continue-on-error") or any(step.get("continue-on-error") for step in steps):
        errors.append(
            "deploy.yml preflight must not set continue-on-error; a failed check has to fail the job"
        )
    deploy_jobs = {
        name: job
        for name, job in jobs.items()
        if isinstance(job, dict) and "self-hosted" in runner_labels(job)
    }
    if not deploy_jobs:
        errors.append("deploy.yml must keep its self-hosted deploy jobs")
    for name, job in sorted(deploy_jobs.items()):
        needs = job.get("needs") or []
        if "preflight" not in ([needs] if isinstance(needs, str) else list(needs)):
            errors.append(f"deploy.yml {name} must need the preflight job")
        if STATUS_OVERRIDE.search(str(job.get("if", ""))):
            errors.append(
                f"deploy.yml {name} must not use always(), failure(), or cancelled(); "
                "it would deploy after a failed preflight"
            )
    return errors


def replace_in_job(text: str, job: str, old: str, new: str) -> str:
    start = text.index(f"\n  {job}:\n")
    following = re.search(r"\n  [A-Za-z0-9_-]+:\n", text[start + 1 :])
    end = start + 1 + following.start() if following else len(text)
    block = text[start:end]
    if old not in block:
        raise AssertionError(f"mutation fixture expects {old!r} in deploy.yml job {job}")
    return text[:start] + block.replace(old, new, 1) + text[end:]


PREFLIGHT_BYPASSES = (
    (
        "deploy-macmini runs after a failed preflight with always()",
        "deploy-macmini",
        "&& success() &&",
        "&& always() &&",
    ),
    (
        "deploy-nasfeo runs after a failed preflight with !cancelled()",
        "deploy-nasfeo",
        "&& success() &&",
        "&& !cancelled() &&",
    ),
    (
        "deploy-nasfeo no longer needs preflight",
        "deploy-nasfeo",
        "    needs: preflight\n",
        "",
    ),
    (
        "the preflight job sets continue-on-error",
        "preflight",
        "    runs-on: ubuntu-latest\n",
        "    runs-on: ubuntu-latest\n    continue-on-error: true\n",
    ),
    (
        "the preflight suite step sets continue-on-error",
        "preflight",
        "        run: LC_ALL=C ./scripts/test-deploy-tooling --offline\n",
        "        continue-on-error: true\n"
        "        run: LC_ALL=C ./scripts/test-deploy-tooling --offline\n",
    ),
    (
        "the preflight suite step ignores its exit status",
        "preflight",
        "        run: LC_ALL=C ./scripts/test-deploy-tooling --offline\n",
        "        run: LC_ALL=C ./scripts/test-deploy-tooling --offline || true\n",
    ),
)

deploy_text = (REPO_DIR / ".github" / "workflows" / "deploy.yml").read_text()
gate_errors = preflight_gate_errors(deploy_text)
if gate_errors:
    raise AssertionError("\n".join(gate_errors))
accepted_bypasses = [
    label
    for label, job, old, new in PREFLIGHT_BYPASSES
    if not preflight_gate_errors(replace_in_job(deploy_text, job, old, new))
]
if accepted_bypasses:
    raise AssertionError(
        "the preflight gate check accepted a deploy.yml where:\n  "
        + "\n  ".join(accepted_bypasses)
    )

offline_workflow = (REPO_DIR / ".github" / "workflows" / "deploy-tooling.yml").read_text()
if "test-deploy-tooling --offline" not in offline_workflow:
    raise AssertionError(
        "GitHub-hosted Deploy Tooling must run scripts/test-deploy-tooling --offline"
    )
if "self-hosted" in offline_workflow:
    raise AssertionError("offline Deploy Tooling must stay on GitHub-hosted runners")

live_path = REPO_DIR / ".github" / "workflows" / "deploy-tooling-live.yml"
if not live_path.is_file():
    raise AssertionError("live tailnet checks must keep a self-hosted workflow")
live_text = live_path.read_text()
live_on, _, _ = live_text.partition("\njobs:\n")
if re.search(r"(?m)^[ \t]*pull_request\s*:", live_on):
    raise AssertionError("deploy-tooling-live.yml must not run from pull_request")
if "workflow_dispatch" not in live_on or "branches: [main]" not in live_on:
    raise AssertionError(
        "deploy-tooling-live.yml must run on push to main and workflow_dispatch"
    )
if "runs-on: [self-hosted, macmini]" not in live_text:
    raise AssertionError("live tailnet checks must run on the macmini self-hosted runner")
if "github.repository == 'feocco/homelab-config'" not in live_text:
    raise AssertionError("the live tailnet job must keep the repository guard")
if "test-deploy-tooling --live" not in live_text:
    raise AssertionError("the live workflow must run scripts/test-deploy-tooling --live")

gate_text = (REPO_DIR / ".github" / "workflows" / "workflow-policy.yml").read_text()
action_refs = re.findall(r"\buses:\s*\S+@([^\s#]+)", gate_text)
if not action_refs or any(
    re.fullmatch(r"[0-9a-f]{40}", reference) is None for reference in action_refs
):
    raise AssertionError("Workflow Policy actions must be pinned to full commit SHAs")
if "runs-on: ubuntu-latest" not in gate_text or "runs-on: self-hosted" in gate_text:
    raise AssertionError("Workflow Policy must use GitHub-hosted runners only")
if "--deploy-workflow .github/workflows/deploy.yml" not in gate_text:
    raise AssertionError("Workflow Policy must explicitly identify deploy.yml")
if (
    "python -m pip install --require-hashes "
    "-r scripts/requirements-workflow-policy.txt"
) not in gate_text:
    raise AssertionError("Workflow Policy must install PyYAML with --require-hashes")

requirements_text = (
    REPO_DIR / "scripts" / "requirements-workflow-policy.txt"
).read_text()
version_pin = re.search(
    r"^PyYAML==[0-9]+(?:\.[0-9]+){2}\s*\\$", requirements_text, re.MULTILINE
)
if version_pin is None:
    raise AssertionError("PyYAML must use an exact version pin")
requirement_hashes = re.findall(r"--hash=sha256:(\S+)", requirements_text)
if not requirement_hashes or any(
    re.fullmatch(r"[0-9a-f]{64}", digest) is None for digest in requirement_hashes
):
    raise AssertionError("PyYAML must use full SHA-256 package hashes")

codeowners = (REPO_DIR / "CODEOWNERS").read_text().splitlines()
for protected_path in (
    "/.github/workflows/ @feocco",
    "/scripts/check-workflow-policy @feocco",
):
    if protected_path not in codeowners:
        raise AssertionError(f"CODEOWNERS must contain {protected_path!r}")

print("Workflow policy fixture checks passed.")
