#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

"${REPO_DIR}/scripts/render-service-env" --host nasfeo --all --base-dir "${REPO_DIR}" --deploy-base-dir "${REPO_DIR}" --dry-run >/dev/null
"${REPO_DIR}/scripts/render-service-env" --host macmini plant-monitor --base-dir "${REPO_DIR}" --deploy-base-dir "${REPO_DIR}" --dry-run >/dev/null
"${REPO_DIR}/scripts/check-service-secrets" --base-dir "${REPO_DIR}"

# Private overlay wins over tracked .env.config without adding Actions secrets.
overlay_root="$(mktemp -d)"
deploy_root="$(mktemp -d)"
trap 'rm -rf "${overlay_root}" "${deploy_root}"' EXIT
mkdir -p "${overlay_root}/macmini" "${deploy_root}/services/caddy"
printf 'CADDY_ACME_EMAIL=private-overlay@example.com\n' > "${overlay_root}/macmini/caddy.env"
export CADDY__CLOUDFLARE_API_TOKEN='test-token'
HOMELAB_PRIVATE_CONFIG_DIR="${overlay_root}" \
  "${REPO_DIR}/scripts/render-service-env" --host macmini caddy \
  --base-dir "${REPO_DIR}" --deploy-base-dir "${deploy_root}" >/dev/null
if ! grep -qx 'CADDY_ACME_EMAIL=private-overlay@example.com' "${deploy_root}/services/caddy/.env"; then
  echo "Private overlay should win for CADDY_ACME_EMAIL" >&2
  cat "${deploy_root}/services/caddy/.env" >&2
  exit 1
fi

# --all: one service's missing secret skips only that service and is recorded,
# so the rest of the host still deploys (it used to abort every service).
all_root="$(mktemp -d)"
names_file="$(mktemp)"
(
  while IFS= read -r name; do
    [[ -n "${name}" ]] && export "${name}=test-value"
  done < <(source "${REPO_DIR}/scripts/lib-service-secrets"; service_secret_prefixed_names "${REPO_DIR}/service-secrets.yaml" | sort -u)
  unset PLANT_MONITOR__HA_URL
  export PLANT_MONITOR__HA_LONG_LIVED_TOKEN=""
  "${REPO_DIR}/scripts/render-service-env" --host macmini --all \
    --base-dir "${REPO_DIR}" --deploy-base-dir "${all_root}" >/dev/null 2>"${all_root}/stderr"
) || { echo "render --all must not fail because one service lacks secrets" >&2; cat "${all_root}/stderr" >&2; exit 1; }
grep -qx 'plant-monitor' "${all_root}/.render-env-skipped" || { echo "Skipped service was not recorded" >&2; exit 1; }
[[ ! -f "${all_root}/services/plant-monitor/.env" ]] || { echo "Skipped service must keep its previous .env" >&2; exit 1; }
[[ -f "${all_root}/services/caddy/.env" ]] || { echo "Other services must still render" >&2; exit 1; }
grep -q 'Empty environment variable PLANT_MONITOR__HA_LONG_LIVED_TOKEN' "${all_root}/stderr" || { echo "Empty secret should be named" >&2; exit 1; }
if CADDY__CLOUDFLARE_API_TOKEN="" "${REPO_DIR}/scripts/render-service-env" --host macmini caddy \
  --base-dir "${REPO_DIR}" --deploy-base-dir "${all_root}" >/dev/null 2>&1; then
  echo "Rendering a single requested service must still fail on a missing secret" >&2
  exit 1
fi

# homelab-deploy refuses a service whose .env render was skipped.
deploy_copy="$(mktemp -d)"
tar -C "${REPO_DIR}" --exclude ./.git -cf - . | tar -C "${deploy_copy}" -xf -
echo plant-monitor > "${deploy_copy}/.render-env-skipped"
if out="$("${deploy_copy}/scripts/homelab-deploy" --host macmini plant-monitor --dry-run --base-dir "${deploy_copy}" --deploy-base-dir "${deploy_copy}" 2>&1)"; then
  echo "homelab-deploy should refuse a service with skipped secrets" >&2; echo "${out}" >&2; exit 1
fi
[[ "${out}" == *"Refusing to deploy plant-monitor"* ]] || { echo "${out}" >&2; exit 1; }

# Declared-secret policy: names only, strict mode blocks a missing one.
(source "${REPO_DIR}/scripts/lib-service-secrets"; service_secret_prefixed_names "${REPO_DIR}/service-secrets.yaml") | grep -vx 'PLANT_MONITOR__HA_URL' > "${names_file}"
if "${REPO_DIR}/scripts/check-declared-secrets-set" --names-file "${names_file}" --strict >/dev/null; then
  echo "check-declared-secrets-set --strict should fail on a missing secret" >&2; exit 1
fi
policy_out="$("${REPO_DIR}/scripts/check-declared-secrets-set" --names-file "${names_file}")"
[[ "${policy_out}" == *PLANT_MONITOR__HA_URL* ]] || { echo "${policy_out}" >&2; exit 1; }
rm -rf "${all_root}" "${deploy_copy}" "${names_file}"

# Multi-line secrets (PEM keys) must survive the .env round trip through
# docker compose instead of breaking the file at the second line.
pem_root="$(mktemp -d)"
pem_value=$'-----BEGIN RSA PRIVATE KEY-----\nMIIfake+/line=two\\with"quote$dollar\n-----END RSA PRIVATE KEY-----'
(
  while IFS= read -r name; do
    [[ "${name}" == WAITING__* ]] && export "${name}=test-value"
  done < <(source "${REPO_DIR}/scripts/lib-service-secrets"; service_secret_prefixed_names "${REPO_DIR}/service-secrets.yaml")
  export WAITING__DASHBOARD_GH_APP_KEY="${pem_value}"
  "${REPO_DIR}/scripts/render-service-env" --host macmini waiting \
    --base-dir "${REPO_DIR}" --deploy-base-dir "${pem_root}" >/dev/null
)
env_file="${pem_root}/services/waiting/.env"
key_lines="$(grep -c '^DASHBOARD_GH_APP_KEY=' "${env_file}")"
[[ "${key_lines}" == 1 ]] || { echo "PEM secret must render as one entry" >&2; exit 1; }
if grep -q '^MIIfake' "${env_file}"; then
  echo "PEM continuation line leaked into .env as its own line" >&2; exit 1
fi
if docker compose version >/dev/null 2>&1; then
  printf 'services:\n  t:\n    image: busybox\n    environment:\n      K: ${DASHBOARD_GH_APP_KEY}\n' > "${pem_root}/compose.yaml"
  parsed="$(docker compose --project-directory "${pem_root}" --env-file "${env_file}" -f "${pem_root}/compose.yaml" config --format json | python3 -c 'import json,sys; print(json.load(sys.stdin)["services"]["t"]["environment"]["K"].replace("$$", "$"), end="")')"  # config output re-escapes $ as $$
  if [[ "${parsed}" != "${pem_value}" ]]; then
    echo "docker compose did not round-trip the PEM secret" >&2; exit 1
  fi
fi
rm -rf "${pem_root}"

# Optional secrets: absent or empty must not block rendering; set ones render.
opt_root="$(mktemp -d)"
opt_env() {
  while IFS= read -r name; do
    if [[ "${name}" == HOMELAB_FUNCTIONS__* ]]; then export "${name}=test-value"; fi
  done < <(source "${REPO_DIR}/scripts/lib-service-secrets"; service_secret_prefixed_names "${REPO_DIR}/service-secrets.yaml")
}
(
  opt_env
  unset HOMELAB_FUNCTIONS__GROK_PEBBLE_WORK_WEBHOOK_URL
  export HOMELAB_FUNCTIONS__GROK_PEBBLE_WORK_WEBHOOK_KEY=""
  "${REPO_DIR}/scripts/render-service-env" --host macmini homelab-functions \
    --base-dir "${REPO_DIR}" --deploy-base-dir "${opt_root}" >/dev/null 2>&1
) || { echo "Missing optional secrets must not fail rendering" >&2; exit 1; }
if grep -q '^GROK_PEBBLE_WORK_WEBHOOK_' "${opt_root}/services/homelab-functions/.env"; then
  echo "Unset optional secrets must be left out of .env" >&2; exit 1
fi
(
  opt_env
  export HOMELAB_FUNCTIONS__GROK_PEBBLE_WORK_WEBHOOK_URL="https://example.invalid/hook"
  export HOMELAB_FUNCTIONS__GROK_PEBBLE_WORK_WEBHOOK_KEY="k"
  "${REPO_DIR}/scripts/render-service-env" --host macmini homelab-functions \
    --base-dir "${REPO_DIR}" --deploy-base-dir "${opt_root}" >/dev/null 2>&1
)
grep -qx 'GROK_PEBBLE_WORK_WEBHOOK_URL=https://example.invalid/hook' "${opt_root}/services/homelab-functions/.env" || { echo "Set optional secret must render" >&2; exit 1; }
grep -qx 'GROK_PEBBLE_WORK_WEBHOOK_KEY=k' "${opt_root}/services/homelab-functions/.env" || exit 1
rm -rf "${opt_root}"
