#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
source "${REPO_DIR}/scripts/tests/lib-test-helpers"

"${REPO_DIR}/scripts/apply-tailscale-serve" --host macmini --base-dir "${REPO_DIR}" --dry-run >/dev/null
"${REPO_DIR}/scripts/ensure-macmini-node-exporter" --dry-run >/dev/null
bash -n "${REPO_DIR}/scripts/check-macmini-monitor-health"
bash -n "${REPO_DIR}/scripts/list-homelab-services"
bash -n "${REPO_DIR}/scripts/redeploy-image"
python3 -m py_compile "${REPO_DIR}/scripts/validate-service-rollout"

python3 - \
  "${REPO_DIR}/services/homelab-monitor/exporters/openai_cost_exporter.py" \
  "${REPO_DIR}/services/homelab-monitor/exporters/docker_stats_exporter.py" <<'PY'
import ast
import pathlib
import sys

for arg in sys.argv[1:]:
    ast.parse(pathlib.Path(arg).read_text(), filename=arg)
PY

tailscale_tmp="$(mktemp -d)"
mkdir -p "${tailscale_tmp}/repo/hosts/testhost" "${tailscale_tmp}/bin"
cp "${REPO_DIR}/scripts/apply-tailscale-serve" "${tailscale_tmp}/repo/apply-tailscale-serve"
cat > "${tailscale_tmp}/repo/hosts/testhost/tailscale-serve.yaml" <<'EOF'
services:
  old-service:
    enabled: false
    http_port: 8080
EOF
cat > "${tailscale_tmp}/bin/tailscale" <<'EOF'
#!/usr/bin/env bash
if [ "$*" = "serve --http=8080 off" ]; then
  echo "error: failed to remove web serve: handler does not exist" >&2
  exit 1
fi
exit 0
EOF
chmod +x "${tailscale_tmp}/repo/apply-tailscale-serve" "${tailscale_tmp}/bin/tailscale"
PATH="${tailscale_tmp}/bin:$PATH" \
  "${tailscale_tmp}/repo/apply-tailscale-serve" --host testhost --base-dir "${tailscale_tmp}/repo" >/dev/null
rm -rf "${tailscale_tmp}"

tmp_runtime="$(mktemp -d)"
mkdir -p "${tmp_runtime}/legacy-service/data" "${tmp_runtime}/services/legacy-service/data"
touch "${tmp_runtime}/services/legacy-service/data/.gitkeep"
echo "state" > "${tmp_runtime}/legacy-service/data/state.txt"
rm -rf "${tmp_runtime}/services/legacy-service/data"
mkdir -p "${tmp_runtime}/services/legacy-service/data"
touch "${tmp_runtime}/services/legacy-service/data/.gitkeep"
rm -rf "${tmp_runtime}/services/legacy-service/data"
"${REPO_DIR}/scripts/migrate-host-runtime-layout" "${tmp_runtime}" >/dev/null
test -f "${tmp_runtime}/services/legacy-service/data/state.txt"
rm -rf "${tmp_runtime}"

guard_tmp="$(mktemp -d)"
guard_repo="${guard_tmp}/repo"
guard_runtime="${guard_tmp}/runtime"
guard_fakebin="${guard_tmp}/bin"
mkdir -p \
  "${guard_repo}/scripts" \
  "${guard_repo}/hosts/macmini" \
  "${guard_repo}/services/demo" \
  "${guard_runtime}/services/demo" \
  "${guard_fakebin}"
cp "${REPO_DIR}/scripts/homelab-deploy" "${guard_repo}/scripts/homelab-deploy"
cp "${REPO_DIR}/scripts/lib-service-secrets" "${guard_repo}/scripts/lib-service-secrets"
chmod +x "${guard_repo}/scripts/homelab-deploy"
cat > "${guard_repo}/hosts/macmini/services.yaml" <<EOF
host:
  name: macmini
  deploy_base_dir: ${guard_runtime}

services:
  demo:
    path: services/demo
    enabled: true
EOF
cat > "${guard_runtime}/services/demo/docker-compose.yml" <<'EOF'
services:
  demo:
    image: ghcr.io/feocco/demo:latest
EOF
cat > "${guard_fakebin}/docker-compose" <<EOF
#!/usr/bin/env bash
printf '%s\n' "\$*" >> "${guard_tmp}/compose.log"
EOF
cat > "${guard_fakebin}/docker" <<'EOF'
#!/usr/bin/env bash
if [ "$1" = "ps" ]; then
  echo "CONTAINER ID   IMAGE   NAMES"
  exit 0
fi
exit 0
EOF
chmod +x "${guard_fakebin}/docker-compose" "${guard_fakebin}/docker"
(
  cd "${guard_repo}"
  git init >/dev/null
  git checkout -b main >/dev/null
  git config user.email "test@example.invalid"
  git config user.name "Deploy Tooling Test"
  git add .
  git commit -m "initial" >/dev/null
)

touch "${guard_repo}/dirty.txt"
dirty_out="${guard_tmp}/dirty.out"
assert_fails "${dirty_out}" env PATH="${guard_fakebin}:$PATH" HOMELAB_CONFIG_DIR="${guard_repo}" \
  "${guard_repo}/scripts/homelab-deploy" --host macmini demo --deploy-base-dir "${guard_runtime}"
assert_contains "${dirty_out}" 'dirty worktree'
PATH="${guard_fakebin}:$PATH" HOMELAB_CONFIG_DIR="${guard_repo}" \
  "${guard_repo}/scripts/homelab-deploy" --host macmini demo --allow-dirty --deploy-base-dir "${guard_runtime}" >/dev/null
assert_json_field "${guard_runtime}/.homelab-deploy-state/macmini/demo.json" git_dirty true
assert_contains "${guard_tmp}/compose.log" '--remove-orphans'
rm -f "${guard_repo}/dirty.txt" "${guard_tmp}/compose.log"

(
  cd "${guard_repo}"
  git checkout -b feature/canary >/dev/null
)
branch_out="${guard_tmp}/branch.out"
assert_fails "${branch_out}" env PATH="${guard_fakebin}:$PATH" HOMELAB_CONFIG_DIR="${guard_repo}" \
  "${guard_repo}/scripts/homelab-deploy" --host macmini demo --deploy-base-dir "${guard_runtime}"
assert_contains "${branch_out}" 'without --canary'
PATH="${guard_fakebin}:$PATH" HOMELAB_CONFIG_DIR="${guard_repo}" \
  "${guard_repo}/scripts/homelab-deploy" --host macmini demo --canary --deploy-base-dir "${guard_runtime}" >/dev/null
assert_json_field "${guard_runtime}/.homelab-deploy-state/macmini/demo.json" canary true
(
  cd "${guard_repo}"
  git checkout main >/dev/null
)
PATH="${guard_fakebin}:$PATH" HOMELAB_CONFIG_DIR="${guard_repo}" \
  "${guard_repo}/scripts/homelab-deploy" --host macmini demo --deploy-base-dir "${guard_runtime}" >/dev/null
assert_json_field "${guard_runtime}/.homelab-deploy-state/macmini/demo.json" git_branch main
rm -rf "${guard_tmp}"

identity_tmp="$(mktemp -d)"
identity_repo="${identity_tmp}/repo"
identity_runtime="${identity_tmp}/runtime"
identity_fakebin="${identity_tmp}/bin"
mkdir -p \
  "${identity_repo}/scripts" \
  "${identity_repo}/hosts/macmini" \
  "${identity_repo}/services/demo" \
  "${identity_runtime}/services/demo" \
  "${identity_fakebin}"
cp "${REPO_DIR}/scripts/homelab-deploy" "${identity_repo}/scripts/homelab-deploy"
cp "${REPO_DIR}/scripts/lib-service-secrets" "${identity_repo}/scripts/lib-service-secrets"
chmod +x "${identity_repo}/scripts/homelab-deploy"
cat > "${identity_repo}/hosts/macmini/services.yaml" <<EOF
host:
  name: macmini
  deploy_base_dir: ${identity_runtime}
  bind_addr: 203.0.113.254

services:
  demo:
    path: services/demo
    enabled: true
EOF
cat > "${identity_runtime}/services/demo/docker-compose.yml" <<'EOF'
services:
  demo:
    image: ghcr.io/feocco/demo:latest
EOF
cat > "${identity_fakebin}/docker-compose" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
cat > "${identity_fakebin}/docker" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
chmod +x "${identity_fakebin}/docker-compose" "${identity_fakebin}/docker"
(
  cd "${identity_repo}"
  git init >/dev/null
  git checkout -b main >/dev/null
  git config user.email "test@example.invalid"
  git config user.name "Deploy Tooling Test"
  git add .
  git commit -m "initial" >/dev/null
)
identity_out="${identity_tmp}/identity.out"
assert_fails "${identity_out}" env PATH="${identity_fakebin}:$PATH" HOMELAB_CONFIG_DIR="${identity_repo}" \
  "${identity_repo}/scripts/homelab-deploy" --host macmini demo --deploy-base-dir "${identity_runtime}"
assert_contains "${identity_out}" 'does not have bind_addr 203.0.113.254'
rm -rf "${identity_tmp}"

caddy_tmp="$(mktemp -d)"
caddy_repo="${caddy_tmp}/repo"
caddy_runtime="${caddy_tmp}/runtime"
caddy_fakebin="${caddy_tmp}/bin"
caddy_auth_config="${caddy_tmp}/auth-config"
caddy_pull_config_file="${caddy_tmp}/pull-config.txt"
mkdir -p \
  "${caddy_repo}/scripts" \
  "${caddy_repo}/hosts/macmini" \
  "${caddy_repo}/services/caddy" \
  "${caddy_runtime}/scripts" \
  "${caddy_runtime}/services/caddy" \
  "${caddy_fakebin}" \
  "${caddy_auth_config}"
cp "${REPO_DIR}/scripts/homelab-deploy" "${caddy_repo}/scripts/homelab-deploy"
cp "${REPO_DIR}/scripts/lib-service-secrets" "${caddy_repo}/scripts/lib-service-secrets"
chmod +x "${caddy_repo}/scripts/homelab-deploy"
cat > "${caddy_repo}/hosts/macmini/services.yaml" <<EOF
host:
  name: macmini
  deploy_base_dir: ${caddy_runtime}

services:
  caddy:
    path: services/caddy
    enabled: true
EOF
cat > "${caddy_runtime}/services/caddy/docker-compose.yml" <<'EOF'
services:
  caddy:
    image: ghcr.io/feocco/homelab-caddy:2.11.4-cloudflare
EOF
cat > "${caddy_runtime}/scripts/generate-caddy-config" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
output=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --output)
      output="$2"
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done
printf '# generated\n' > "${output}"
EOF
chmod +x "${caddy_runtime}/scripts/generate-caddy-config"
cat > "${caddy_fakebin}/docker" <<'EOF'
#!/usr/bin/env bash
config="${DOCKER_CONFIG:-}"
if [ "${1:-}" = "--config" ]; then
  config="$2"
  shift 2
fi
if [ "${1:-}" = "compose" ] && [ "${2:-}" = "version" ]; then
  exit 0
fi
if [ "${1:-}" = "compose" ] && [ "${2:-}" = "pull" ]; then
  printf '%s\n' "${config}" > "${CADDY_PULL_CONFIG_FILE}"
  if [ "${config}" = "${ORIGINAL_DOCKER_CONFIG}" ]; then
    echo "caddy pull used the authenticated GHCR Docker config" >&2
    exit 42
  fi
  exit 0
fi
if [ "${1:-}" = "compose" ] && [ "${2:-}" = "up" ]; then
  exit 0
fi
if [ "${1:-}" = "ps" ]; then
  echo "CONTAINER ID   IMAGE   NAMES"
  exit 0
fi
exit 0
EOF
chmod +x "${caddy_fakebin}/docker"
(
  cd "${caddy_repo}"
  git init >/dev/null
  git checkout -b main >/dev/null
  git config user.email "test@example.invalid"
  git config user.name "Deploy Tooling Test"
  git add .
  git commit -m "initial" >/dev/null
)
PATH="${caddy_fakebin}:$PATH" \
  DOCKER_CONFIG="${caddy_auth_config}" \
  ORIGINAL_DOCKER_CONFIG="${caddy_auth_config}" \
  CADDY_PULL_CONFIG_FILE="${caddy_pull_config_file}" \
  HOMELAB_CONFIG_DIR="${caddy_repo}" \
  "${caddy_repo}/scripts/homelab-deploy" --host macmini caddy --deploy-base-dir "${caddy_runtime}" >/dev/null
if [ "$(cat "${caddy_pull_config_file}")" = "${caddy_auth_config}" ]; then
  echo "Caddy deploy should pull with an anonymous Docker config." >&2
  exit 1
fi
rm -rf "${caddy_tmp}"

if grep -R '\${{ github.event.inputs\.' "${REPO_DIR}/.github/workflows"; then
  echo "Deploy workflows must not interpolate github.event.inputs directly into shell scripts." >&2
  exit 1
fi

if grep -q 'docker logout ghcr.io' "${REPO_DIR}/.github/workflows/deploy.yml"; then
  echo "Deploy workflow must keep GHCR credentials available for compose pull." >&2
  exit 1
fi
