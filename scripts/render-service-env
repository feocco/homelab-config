#!/bin/bash
set -euo pipefail

BASE_DIR="${GITHUB_WORKSPACE:-$(pwd)}"
DEPLOY_BASE_DIR="${HOMELAB_CONFIG_DIR:-/volume1/docker/homelab-config}"
DRY_RUN="false"
ALL="false"
SERVICE=""
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "${SCRIPT_DIR}/lib-service-secrets"

usage() {
  cat <<'EOF'
Usage:
  render-service-env <service> [--base-dir DIR] [--deploy-base-dir DIR] [--dry-run]
  render-service-env --all [--base-dir DIR] [--deploy-base-dir DIR] [--dry-run]

Reads service-secrets.yaml to find required variable names and renders NAS
runtime .env files from environment variables named:

  <SERVICE_PREFIX>__<VARIABLE_NAME>

Values are never printed.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --base-dir)
      BASE_DIR="${2:?--base-dir requires a value}"
      shift 2
      ;;
    --deploy-base-dir)
      DEPLOY_BASE_DIR="${2:?--deploy-base-dir requires a value}"
      shift 2
      ;;
    --dry-run)
      DRY_RUN="true"
      shift
      ;;
    --all)
      ALL="true"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      SERVICE="$1"
      shift
      ;;
  esac
done

if [[ -z "${SERVICE}" && "${ALL}" != "true" ]]; then
  usage >&2
  exit 2
fi

SERVICES_FILE="${BASE_DIR}/services.yaml"
MANIFEST_FILE="$(service_secret_manifest "${BASE_DIR}")"
if [[ ! -f "${SERVICES_FILE}" ]]; then
  echo "Missing ${SERVICES_FILE}" >&2
  exit 2
fi

if [[ ! -f "${MANIFEST_FILE}" ]]; then
  echo "Missing ${MANIFEST_FILE}" >&2
  exit 2
fi

render_service() {
  local service="$1"
  local service_path service_dir prefix tmp_file count

  service_path="$(service_secret_service_path "${SERVICES_FILE}" "${service}")"
  if [[ -z "${service_path}" ]]; then
    echo "Unsupported service: ${service}" >&2
    exit 2
  fi

  if [[ -z "$(service_secret_keys "${MANIFEST_FILE}" "${service}")" ]]; then
    echo "No secrets listed for ${service} in ${MANIFEST_FILE}" >&2
    exit 2
  fi

  service_dir="${DEPLOY_BASE_DIR}/${service_path}"
  prefix="$(service_secret_prefix "${service}")"

  if [[ "${DRY_RUN}" == "true" ]]; then
    while IFS= read -r key; do
      secret_name="${prefix}__${key}"
      echo "Would render ${service}/${key} from ${secret_name}"
    done < <(service_secret_keys "${MANIFEST_FILE}" "${service}")
    return
  fi

  mkdir -p "${service_dir}"
  tmp_file="${service_dir}/.env.tmp.$$"
  umask 077

  cleanup() {
    rm -f "${tmp_file}"
  }
  trap cleanup EXIT

  while IFS= read -r key; do
    secret_name="${prefix}__${key}"
    if [[ -z "${!secret_name+x}" ]]; then
      echo "Missing environment variable ${secret_name}" >&2
      exit 2
    fi
    printf '%s=%s\n' "${key}" "${!secret_name}" >> "${tmp_file}"
  done < <(service_secret_keys "${MANIFEST_FILE}" "${service}")

  chmod 600 "${tmp_file}"
  mv "${tmp_file}" "${service_dir}/.env"
  trap - EXIT
  count="$(service_secret_keys "${MANIFEST_FILE}" "${service}" | wc -l | tr -d ' ')"
  echo "Rendered ${service}/.env with ${count} values"
}

if [[ "${ALL}" == "true" ]]; then
  while IFS= read -r service; do
    [[ -n "${service}" ]] && render_service "${service}"
  done < <(service_secret_services "${MANIFEST_FILE}")
else
  render_service "${SERVICE}"
fi
