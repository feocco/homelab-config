#!/bin/bash
set -euo pipefail

BASE_DIR="${GITHUB_WORKSPACE:-$(pwd)}"
HOST="nasfeo"
DEPLOY_BASE_DIR=""
DRY_RUN="false"
ALL="false"
SERVICE=""
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "${SCRIPT_DIR}/lib-service-secrets"

usage() {
  cat <<'EOF'
Usage:
  render-service-env [--host HOST] <service> [--base-dir DIR] [--deploy-base-dir DIR] [--dry-run]
  render-service-env [--host HOST] --all [--base-dir DIR] [--deploy-base-dir DIR] [--dry-run]

Renders runtime .env files from shared tracked .env.config values, optional
host-specific overrides in hosts/<host>/<service>.env.config, and
service-secrets.yaml values provided by environment variables named:

  <SERVICE_PREFIX>__<VARIABLE_NAME>

Values are never printed.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --host)
      HOST="${2:?--host requires a value}"
      shift 2
      ;;
    --base-dir)
      BASE_DIR="${2:?--base-dir requires a value}"
      shift 2
      ;;
    --deploy-base-dir)
      DEPLOY_BASE_DIR="${2:?--deploy-base-dir requires a value}"
      shift 2
      ;;
    --dry-run)
      DRY_RUN="true"
      shift
      ;;
    --all)
      ALL="true"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      SERVICE="$1"
      shift
      ;;
  esac
done

if [[ -z "${SERVICE}" && "${ALL}" != "true" ]]; then
  usage >&2
  exit 2
fi

SERVICES_FILE="$(service_secret_services_file "${BASE_DIR}" "${HOST}")"
MANIFEST_FILE="$(service_secret_manifest "${BASE_DIR}")"
if [[ ! -f "${SERVICES_FILE}" ]]; then
  echo "Missing host services file: ${SERVICES_FILE}" >&2
  exit 2
fi

if [[ ! -f "${MANIFEST_FILE}" ]]; then
  echo "Missing ${MANIFEST_FILE}" >&2
  exit 2
fi

if [[ -z "${DEPLOY_BASE_DIR}" ]]; then
  DEPLOY_BASE_DIR="$(service_secret_host_deploy_base_dir "${SERVICES_FILE}")"
fi

if [[ -z "${DEPLOY_BASE_DIR}" ]]; then
  DEPLOY_BASE_DIR="${BASE_DIR}"
fi
DEPLOY_BASE_DIR="$(service_secret_expand_path "${DEPLOY_BASE_DIR}")"

env_key_from_files() {
  local file
  for file in "$@"; do
    [[ -f "${file}" ]] || continue
    service_secret_env_keys "${file}"
  done | awk '!seen[$0]++'
}

env_value_from_files() {
  local key="$1"
  local file
  shift
  for file in "$@"; do
    [[ -f "${file}" ]] || continue
    if service_secret_env_value "${file}" "${key}" >/dev/null 2>&1; then
      service_secret_env_value "${file}" "${key}"
      return 0
    fi
  done
  return 1
}

render_service() {
  local service="$1"
  local service_path service_dir prefix shared_config host_config tmp_file count config_count secret_count key value

  service_path="$(service_secret_service_path "${SERVICES_FILE}" "${service}")"
  if [[ -z "${service_path}" ]]; then
    echo "Unsupported service on ${HOST}: ${service}" >&2
    exit 2
  fi

  service_dir="${DEPLOY_BASE_DIR}/${service_path}"
  prefix="$(service_secret_prefix "${service}")"
  shared_config="${BASE_DIR}/${service_path}/.env.config"
  host_config="$(service_secret_host_config_file "${BASE_DIR}" "${HOST}" "${service}")"

  if [[ ! -f "${shared_config}" && ! -f "${host_config}" && -z "$(service_secret_keys "${MANIFEST_FILE}" "${service}")" ]]; then
    if [[ "${ALL}" == "true" ]]; then
      return
    fi
    echo "No runtime env config or secrets listed for ${service}" >&2
    exit 2
  fi

  if [[ "${DRY_RUN}" == "true" ]]; then
    while IFS= read -r key; do
      [[ -n "${key}" ]] || continue
      echo "Would render ${service}/${key} from tracked env config for ${HOST}"
    done < <(env_key_from_files "${host_config}" "${shared_config}")
    while IFS= read -r key; do
      secret_name="${prefix}__${key}"
      echo "Would render ${service}/${key} from ${secret_name}"
    done < <(service_secret_keys "${MANIFEST_FILE}" "${service}")
    return
  fi

  mkdir -p "${service_dir}"
  tmp_file="${service_dir}/.env.tmp.$$"
  umask 077

  cleanup() {
    rm -f "${tmp_file}"
  }
  trap cleanup EXIT

  while IFS= read -r key; do
    [[ -n "${key}" ]] || continue
    if ! value="$(env_value_from_files "${key}" "${host_config}" "${shared_config}")"; then
      echo "Missing ${key} in env config for ${service} on ${HOST}" >&2
      exit 2
    fi
    printf '%s=%s\n' "${key}" "${value}" >> "${tmp_file}"
  done < <(env_key_from_files "${host_config}" "${shared_config}")

  while IFS= read -r key; do
    secret_name="${prefix}__${key}"
    if [[ -z "${!secret_name+x}" ]]; then
      echo "Missing environment variable ${secret_name}" >&2
      exit 2
    fi
    if [[ -z "${!secret_name}" ]]; then
      echo "Empty environment variable ${secret_name}" >&2
      exit 2
    fi
    printf '%s=%s\n' "${key}" "${!secret_name}" >> "${tmp_file}"
  done < <(service_secret_keys "${MANIFEST_FILE}" "${service}")

  chmod 600 "${tmp_file}"
  mv "${tmp_file}" "${service_dir}/.env"
  trap - EXIT
  config_count="$(env_key_from_files "${host_config}" "${shared_config}" | wc -l | tr -d ' ')"
  secret_count="$(service_secret_keys "${MANIFEST_FILE}" "${service}" | wc -l | tr -d ' ')"
  count="$((config_count + secret_count))"
  echo "Rendered ${service}/.env for ${HOST} with ${count} values"
}

if [[ "${ALL}" == "true" ]]; then
  while IFS= read -r service; do
    [[ -n "${service}" ]] && render_service "${service}"
  done < <(service_secret_runtime_services "${BASE_DIR}" "${SERVICES_FILE}" "${MANIFEST_FILE}")
else
  render_service "${SERVICE}"
fi
