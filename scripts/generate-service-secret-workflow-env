#!/bin/bash
set -euo pipefail

BASE_DIR="$(pwd)"
WORKFLOW_FILE=""
CHECK="false"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "${SCRIPT_DIR}/lib-service-secrets"

usage() {
  cat <<'EOF'
Usage:
  generate-service-secret-workflow-env [--base-dir DIR] [--workflow FILE] [--check]

Regenerates the marked GitHub Actions env block from service-secrets.yaml.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --base-dir)
      BASE_DIR="${2:?--base-dir requires a value}"
      shift 2
      ;;
    --workflow)
      WORKFLOW_FILE="${2:?--workflow requires a value}"
      shift 2
      ;;
    --check)
      CHECK="true"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

WORKFLOW_FILE="${WORKFLOW_FILE:-${BASE_DIR}/.github/workflows/deploy.yml}"
MANIFEST_FILE="$(service_secret_manifest "${BASE_DIR}")"
BEGIN_MARKER="          # BEGIN GENERATED SERVICE SECRETS"
END_MARKER="          # END GENERATED SERVICE SECRETS"

if [[ ! -f "${WORKFLOW_FILE}" ]]; then
  echo "Missing ${WORKFLOW_FILE}" >&2
  exit 2
fi

if [[ ! -f "${MANIFEST_FILE}" ]]; then
  echo "Missing ${MANIFEST_FILE}" >&2
  exit 2
fi

generated_block() {
  echo "${BEGIN_MARKER}"
  while IFS= read -r secret_name; do
    [[ -n "${secret_name}" ]] || continue
    printf '          %s: ${{ secrets.%s }}\n' "${secret_name}" "${secret_name}"
  done < <(service_secret_prefixed_names "${MANIFEST_FILE}" | sort)
  echo "${END_MARKER}"
}

tmp_file="$(mktemp)"
new_file="$(mktemp)"
trap 'rm -f "${tmp_file}" "${new_file}"' EXIT

generated_block > "${tmp_file}"

awk -v begin="${BEGIN_MARKER}" -v end="${END_MARKER}" -v block="${tmp_file}" '
  $0 == begin {
    while ((getline line < block) > 0) {
      print line
    }
    close(block)
    in_block=1
    next
  }
  $0 == end {
    in_block=0
    next
  }
  !in_block {
    print
  }
' "${WORKFLOW_FILE}" > "${new_file}"

if ! grep -qxF "${BEGIN_MARKER}" "${WORKFLOW_FILE}" || ! grep -qxF "${END_MARKER}" "${WORKFLOW_FILE}"; then
  echo "Missing generated service secret markers in ${WORKFLOW_FILE}" >&2
  exit 2
fi

if [[ "${CHECK}" == "true" ]]; then
  if ! diff -u "${WORKFLOW_FILE}" "${new_file}"; then
    echo "Generated service secret env block is stale. Run scripts/generate-service-secret-workflow-env." >&2
    exit 1
  fi
  echo "Generated service secret env block is current."
  exit 0
fi

mv "${new_file}" "${WORKFLOW_FILE}"
trap - EXIT
rm -f "${tmp_file}"
echo "Updated ${WORKFLOW_FILE}"
