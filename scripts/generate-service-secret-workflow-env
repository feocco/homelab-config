#!/bin/bash
set -euo pipefail

BASE_DIR="$(pwd)"
WORKFLOW_FILE=""
CHECK="false"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "${SCRIPT_DIR}/lib-service-secrets"

usage() {
  cat <<'EOF'
Usage:
  generate-service-secret-workflow-env [--base-dir DIR] [--workflow FILE] [--check]

Regenerates the marked GitHub Actions env blocks from service-secrets.yaml.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --base-dir)
      BASE_DIR="${2:?--base-dir requires a value}"
      shift 2
      ;;
    --workflow)
      WORKFLOW_FILE="${2:?--workflow requires a value}"
      shift 2
      ;;
    --check)
      CHECK="true"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

WORKFLOW_FILE="${WORKFLOW_FILE:-${BASE_DIR}/.github/workflows/deploy.yml}"
MANIFEST_FILE="$(service_secret_manifest "${BASE_DIR}")"
BEGIN_MARKER="          # BEGIN GENERATED SERVICE SECRETS"
END_MARKER="          # END GENERATED SERVICE SECRETS"

if [[ ! -f "${WORKFLOW_FILE}" ]]; then
  echo "Missing ${WORKFLOW_FILE}" >&2
  exit 2
fi

if [[ ! -f "${MANIFEST_FILE}" ]]; then
  echo "Missing ${MANIFEST_FILE}" >&2
  exit 2
fi

host_for_marker() {
  local marker_line="$1"
  local host

  host="$(awk -v marker_line="${marker_line}" '
    NR > marker_line && /render-service-env/ {
      for (i = 1; i <= NF; i++) {
        if ($i == "--host") {
          print $(i + 1)
          exit
        }
      }
    }
  ' "${WORKFLOW_FILE}")"

  if [[ -z "${host}" ]]; then
    echo "Could not determine host for generated service secret block starting at line ${marker_line}" >&2
    exit 2
  fi

  printf '%s\n' "${host}"
}

generated_block() {
  local host="$1"
  local services_file service secret_name key prefix

  services_file="$(service_secret_services_file "${BASE_DIR}" "${host}")"
  if [[ ! -f "${services_file}" ]]; then
    echo "Missing host services file for generated secret block: ${services_file}" >&2
    exit 2
  fi

  echo "${BEGIN_MARKER}"
  while IFS= read -r service; do
    [[ -n "${service}" ]] || continue
    prefix="$(service_secret_prefix "${service}")"
    while IFS= read -r key; do
      [[ -n "${key}" ]] || continue
      secret_name="${prefix}__${key}"
      printf '          %s: ${{ secrets.%s }}\n' "${secret_name}" "${secret_name}"
    done < <(service_secret_keys "${MANIFEST_FILE}" "${service}")
  done < <(service_secret_enabled_service_names "${services_file}") | sort
  echo "${END_MARKER}"
}

new_file="$(mktemp)"
trap 'rm -f "${new_file}"' EXIT

line_number=0
in_block="false"
while IFS= read -r line || [[ -n "${line}" ]]; do
  line_number=$((line_number + 1))
  if [[ "${line}" == "${BEGIN_MARKER}" ]]; then
    generated_block "$(host_for_marker "${line_number}")" >> "${new_file}"
    in_block="true"
    continue
  fi
  if [[ "${line}" == "${END_MARKER}" ]]; then
    in_block="false"
    continue
  fi
  if [[ "${in_block}" == "false" ]]; then
    printf '%s\n' "${line}" >> "${new_file}"
  fi
done < "${WORKFLOW_FILE}"

if ! grep -qxF "${BEGIN_MARKER}" "${WORKFLOW_FILE}" || ! grep -qxF "${END_MARKER}" "${WORKFLOW_FILE}"; then
  echo "Missing generated service secret markers in ${WORKFLOW_FILE}" >&2
  exit 2
fi

if [[ "${CHECK}" == "true" ]]; then
  if ! diff -u "${WORKFLOW_FILE}" "${new_file}"; then
    echo "Generated service secret env block is stale. Run scripts/generate-service-secret-workflow-env." >&2
    exit 1
  fi
  echo "Generated service secret env block is current."
  exit 0
fi

mv "${new_file}" "${WORKFLOW_FILE}"
trap - EXIT
echo "Updated ${WORKFLOW_FILE}"
