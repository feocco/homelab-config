#!/bin/bash
set -euo pipefail

BASE_DIR="${HOMELAB_CONFIG_DIR:-/volume1/docker/homelab-config}"
DEPLOY_BASE_DIR=""
COMPOSE_IMAGE="${COMPOSE_IMAGE:-docker/compose:1.29.2}"
MODE=""
SERVICE=""
DRY_RUN="false"

usage() {
  cat <<'EOF'
Usage:
  homelab-deploy --list
  homelab-deploy --all [--dry-run]
  homelab-deploy --changed [--dry-run] [--base-dir DIR] [--deploy-base-dir DIR]
  homelab-deploy <service> [--dry-run] [--deploy-base-dir DIR]
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --list)
      MODE="list"
      shift
      ;;
    --all)
      MODE="all"
      shift
      ;;
    --changed)
      MODE="changed"
      shift
      ;;
    --dry-run)
      DRY_RUN="true"
      shift
      ;;
    --base-dir)
      BASE_DIR="${2:?--base-dir requires a value}"
      shift 2
      ;;
    --deploy-base-dir)
      DEPLOY_BASE_DIR="${2:?--deploy-base-dir requires a value}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      SERVICE="$1"
      MODE="${MODE:-service}"
      shift
      ;;
  esac
done

if [[ -z "${MODE}" ]]; then
  usage >&2
  exit 2
fi

DEPLOY_BASE_DIR="${DEPLOY_BASE_DIR:-${BASE_DIR}}"
SERVICES_FILE="${BASE_DIR}/services.yaml"

if [[ ! -f "${SERVICES_FILE}" ]]; then
  echo "Missing ${SERVICES_FILE}" >&2
  exit 2
fi

service_entries() {
  awk '
    function emit() {
      if (name != "" && enabled != "false") {
        print name "|" path
      }
    }
    /^services:[[:space:]]*$/ {
      in_services=1
      next
    }
    in_services && /^  [^[:space:]].*:[[:space:]]*$/ {
      emit()
      name=$1
      sub(/:$/, "", name)
      path=""
      enabled="true"
      next
    }
    in_services && /^    path:/ {
      path=$2
      next
    }
    in_services && /^    enabled:/ {
      enabled=$2
      next
    }
    END {
      emit()
    }
  ' "${SERVICES_FILE}"
}

service_path() {
  local service="$1"
  service_entries | awk -F'|' -v service="${service}" '$1 == service { print $2 }'
}

enabled_service_names() {
  service_entries | awk -F'|' '{ print $1 }' | sort
}

changed_files() {
  local before="${BEFORE_SHA:-}"
  local after="${AFTER_SHA:-HEAD}"
  if [[ -n "${before}" && "${before}" != "0000000000000000000000000000000000000000" ]]; then
    git -C "${BASE_DIR}" diff --name-only "${before}" "${after}" 2>/dev/null && return 0
  fi
  git -C "${BASE_DIR}" diff --name-only HEAD~1 "${after}" 2>/dev/null && return 0
  git -C "${BASE_DIR}" show --name-only --format= "${after}"
}

changed_services() {
  local files
  files="$(changed_files)"
  while IFS='|' read -r service path; do
    [[ -n "${service}" ]] || continue
    if echo "${files}" | grep -qx "services.yaml" || echo "${files}" | grep -qx "service-secrets.yaml" || echo "${files}" | grep -q "^${path}/"; then
      echo "${service}"
    fi
  done < <(service_entries)
}

deploy_service() {
  local service="$1"
  local path
  local service_dir

  path="$(service_path "${service}")"
  if [[ -z "${path}" ]]; then
    echo "Unsupported or disabled service: ${service}" >&2
    exit 2
  fi

  service_dir="${DEPLOY_BASE_DIR}/${path}"
  if [[ ! -f "${service_dir}/docker-compose.yml" ]]; then
    echo "Missing compose file: ${service_dir}/docker-compose.yml" >&2
    exit 2
  fi

  echo "Deploying ${service} from ${service_dir}"
  if [[ "${DRY_RUN}" == "true" ]]; then
    return 0
  fi

  (
    cd "${service_dir}"
    compose pull
    compose up -d
    docker ps --filter "name=${service}"
  )
}

compose() {
  if command -v docker-compose >/dev/null 2>&1; then
    docker-compose "$@"
    return
  fi

  if ! command -v docker >/dev/null 2>&1; then
    echo "Neither docker-compose nor docker is available." >&2
    exit 2
  fi

  docker run --rm \
    -v /var/run/docker.sock:/var/run/docker.sock \
    -v "${DEPLOY_BASE_DIR}:${DEPLOY_BASE_DIR}" \
    -w "$PWD" \
    "${COMPOSE_IMAGE}" "$@"
}

case "${MODE}" in
  list)
    enabled_service_names
    ;;
  all)
    while read -r service; do
      [[ -n "${service}" ]] && deploy_service "${service}"
    done < <(enabled_service_names)
    ;;
  changed)
    targets="$(changed_services | sort -u)"
    if [[ -z "${targets}" ]]; then
      echo "No enabled services to deploy."
      exit 0
    fi
    while read -r service; do
      [[ -n "${service}" ]] && deploy_service "${service}"
    done <<< "${targets}"
    ;;
  service)
    deploy_service "${SERVICE}"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
