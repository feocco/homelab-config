#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
import subprocess
import sys
from pathlib import Path

DEFAULT_BASE_DIR = Path(os.environ.get("HOMELAB_CONFIG_DIR", "/volume1/docker/homelab-config"))


def main() -> int:
    parser = argparse.ArgumentParser(description="Deploy homelab Compose services.")
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("service", nargs="?", help="Service name from services.yaml.")
    group.add_argument("--list", action="store_true", help="List enabled services.")
    group.add_argument("--all", action="store_true", help="Deploy all enabled services.")
    group.add_argument("--changed", action="store_true", help="Deploy enabled services changed by git diff.")
    parser.add_argument("--dry-run", action="store_true", help="Print actions without running docker-compose.")
    parser.add_argument("--base-dir", default=str(DEFAULT_BASE_DIR), help="Config repo path used for services.yaml and git diff.")
    parser.add_argument("--deploy-base-dir", help="Runtime path used for docker-compose. Defaults to --base-dir.")
    args = parser.parse_args()

    base_dir = Path(args.base_dir)
    deploy_base_dir = Path(args.deploy_base_dir or args.base_dir)

    services = load_services(base_dir)
    if args.list:
        for name in sorted(enabled_services(services)):
            print(name)
        return 0

    if args.all:
        targets = sorted(enabled_services(services))
    elif args.changed:
        targets = changed_services(services, base_dir)
    else:
        targets = [args.service]

    if not targets:
        print("No enabled services to deploy.")
        return 0

    for service in targets:
        deploy_service(service, services, deploy_base_dir, dry_run=args.dry_run)
    return 0


def load_services(base_dir: Path) -> dict:
    services_file = base_dir / "services.yaml"
    if not services_file.exists():
        raise SystemExit(f"Missing {services_file}")
    services: dict[str, dict] = {}
    current: str | None = None
    in_services = False
    for raw_line in services_file.read_text().splitlines():
        line = raw_line.split("#", 1)[0].rstrip()
        if not line:
            continue
        if line == "services:":
            in_services = True
            continue
        if not in_services:
            continue
        if line.startswith("  ") and not line.startswith("    ") and line.strip().endswith(":"):
            current = line.strip()[:-1]
            services[current] = {}
            continue
        if current and line.startswith("    ") and ":" in line:
            key, value = line.strip().split(":", 1)
            services[current][key] = parse_value(value.strip())
    if not services:
        raise SystemExit("services.yaml must contain services")
    return services


def parse_value(value: str):
    if value.lower() == "true":
        return True
    if value.lower() == "false":
        return False
    return value.strip("\"'")


def enabled_services(services: dict) -> dict[str, dict]:
    return {
        name: config
        for name, config in services.items()
        if isinstance(config, dict) and config.get("enabled", True)
    }


def changed_services(services: dict, base_dir: Path) -> list[str]:
    changed = git_changed_files(base_dir)
    targets: list[str] = []
    for name, config in enabled_services(services).items():
        path = str(config["path"]).strip("/")
        if any(file == "services.yaml" or file.startswith(f"{path}/") for file in changed):
            targets.append(name)
    return sorted(set(targets))


def git_changed_files(base_dir: Path) -> list[str]:
    before = os.environ.get("BEFORE_SHA")
    after = os.environ.get("AFTER_SHA", "HEAD")
    if before and before != "0000000000000000000000000000000000000000":
        command = ["git", "diff", "--name-only", before, after]
    else:
        command = ["git", "diff", "--name-only", "HEAD~1", after]
    result = subprocess.run(command, cwd=base_dir, text=True, capture_output=True)
    if result.returncode != 0:
        result = subprocess.run(["git", "show", "--name-only", "--format=", after], cwd=base_dir, text=True, capture_output=True)
    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or "Unable to determine changed files")
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def deploy_service(service: str, services: dict, deploy_base_dir: Path, dry_run: bool) -> None:
    enabled = enabled_services(services)
    if service not in enabled:
        raise SystemExit(f"Unsupported or disabled service: {service}")

    service_dir = deploy_base_dir / str(enabled[service]["path"])
    compose_file = service_dir / "docker-compose.yml"
    if not compose_file.exists():
        raise SystemExit(f"Missing compose file: {compose_file}")

    print(f"Deploying {service} from {service_dir}")
    if dry_run:
        return

    run(["docker-compose", "pull"], cwd=service_dir)
    run(["docker-compose", "up", "-d"], cwd=service_dir)
    run(["docker", "ps", "--filter", f"name={service}"], cwd=service_dir)


def run(command: list[str], cwd: Path) -> None:
    subprocess.run(command, cwd=cwd, check=True)


if __name__ == "__main__":
    raise SystemExit(main())
