#!/bin/bash
set -euo pipefail

# CLI helper for inspecting Tailscale identity/trust state without the admin
# console. Tags and serve state come from the local `tailscale` CLI. The full
# ACL/grants policy needs a Tailscale API access token because the CLI does not
# expose the live policy file. TAILSCALE_POLICY_FILE supports offline checks.
#
# Auth (one-time): create an API access token at
#   https://login.tailscale.com/admin/settings/keys  (or an OAuth client)
# then export it:
#   export TAILSCALE_API_KEY=tskey-api-...
# Optionally set TAILNET (default "-", meaning the token's default tailnet).

TAILNET="${TAILNET:--}"
API_KEY="${TAILSCALE_API_KEY:-${TS_API_KEY:-}}"
POLICY_FILE="${TAILSCALE_POLICY_FILE:-}"
MODE="status"
SERVICE_HOST_TAG="tag:homelab-service-host"
FRIEND_SERVICES=("svc:authentik" "svc:pirate-radio")
CURSOR_CLOUD_TAG="tag:cursor-cloud"
STOCKFISH_SERVICE="svc:stockfish-evaluator"

usage() {
  cat <<'EOF'
Usage:
  tailscale-acl status   Show tagged homelab hosts and serve state (CLI only).
  tailscale-acl get      Print the live ACL/grants policy (needs API key).
  tailscale-acl check    Verify tag owners and scoped service grants.

Auth for get/check:
  export TAILSCALE_API_KEY=tskey-api-...   # from admin > settings > keys
  export TAILNET=example.com               # optional; default is token tailnet

Offline check:
  TAILSCALE_POLICY_FILE=path/to/policy.hujson tailscale-acl check
EOF
}

[[ $# -gt 0 ]] && case "$1" in
  status|get|check) MODE="$1"; shift ;;
  -h|--help) usage; exit 0 ;;
  *) echo "Unknown command: $1" >&2; usage >&2; exit 2 ;;
esac

require_cli() {
  command -v tailscale >/dev/null 2>&1 || { echo "tailscale CLI not found on PATH" >&2; exit 2; }
}

show_status() {
  require_cli
  echo "== Tagged homelab hosts =="
  local status_json
  status_json="$(mktemp)"
  trap 'rm -f "${status_json}"' RETURN
  tailscale status --json > "${status_json}" 2>/dev/null || true
  if [[ ! -s "${status_json}" ]]; then
    echo "  tailscale status --json returned nothing (daemon down or not logged in)" >&2
    return 1
  fi
  python3 - "${status_json}" "${SERVICE_HOST_TAG}" <<'PY'
import json, sys
data = json.load(open(sys.argv[1]))
tag = sys.argv[2]
nodes = []
self = data.get("Self")
if self:
    nodes.append(self)
nodes.extend((data.get("Peer") or {}).values())
found = False
for n in nodes:
    tags = n.get("Tags") or []
    if tag in tags:
        found = True
        print(f"  {n.get('HostName')} ({(n.get('DNSName') or '').rstrip('.')}) online={n.get('Online')}")
if not found:
    print(f"  NONE tagged {tag} -- friend Services will not serve!")
PY
  echo
  echo "== Serve config (run on the serving host for full detail) =="
  local serve_json_file
  serve_json_file="$(mktemp)"
  trap 'rm -f "${serve_json_file}"' RETURN
  if tailscale serve status --json > "${serve_json_file}" 2>/dev/null && [[ -s "${serve_json_file}" ]]; then
    python3 - "${serve_json_file}" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
services = d.get("Services") or {}
if services:
    print("  Named services:")
    for name, cfg in sorted(services.items()):
        print(f"    {name}: {json.dumps(cfg, separators=(',', ':'))}")
else:
    print("  Named services: none")
tcp = d.get("TCP") or {}
if tcp:
    ports = ", ".join(sorted(tcp, key=lambda x: int(x) if str(x).isdigit() else 0))
    print(f"  TCP ports: {ports}")
PY
  else
    tailscale serve status 2>&1 | sed 's/^/  /' || true
  fi
}

api_get() {
  [[ -n "${API_KEY}" ]] || { echo "Set TAILSCALE_API_KEY to use '${MODE}'." >&2; exit 2; }
  # Tailscale access tokens use HTTP Basic with the key as the username and an
  # empty password. Build the header ourselves so scanners do not flag `curl -u`.
  local basic
  basic="$(printf '%s:' "${API_KEY}" | base64 | tr -d '\n')"
  curl -sf \
    -H "Authorization: Basic ${basic}" \
    -H "Accept: application/hujson" \
    "https://api.tailscale.com/api/v2/tailnet/${TAILNET}/acl"
}

policy_get() {
  if [[ -n "${POLICY_FILE}" ]]; then
    [[ -f "${POLICY_FILE}" ]] || { echo "TAILSCALE_POLICY_FILE does not exist: ${POLICY_FILE}" >&2; exit 2; }
    command cat "${POLICY_FILE}"
  else
    api_get
  fi
}

case "${MODE}" in
  status) show_status ;;
  get) api_get ;;
  check)
    policy_file="$(mktemp)"
    trap 'rm -f "${policy_file}"' EXIT
    policy_get > "${policy_file}"
    python3 - "${policy_file}" "${SERVICE_HOST_TAG}" "${CURSOR_CLOUD_TAG}" "${STOCKFISH_SERVICE}" "${FRIEND_SERVICES[@]}" <<'PY'
import json, re, sys
policy_path = sys.argv[1]
service_host_tag = sys.argv[2]
cursor_cloud_tag = sys.argv[3]
stockfish_service = sys.argv[4]
friend_services = sys.argv[5:]
raw = open(policy_path).read()
# Tolerate HuJSON: strip // and /* */ comments and trailing commas.
raw = re.sub(r"/\*.*?\*/", "", raw, flags=re.S)
raw = re.sub(r"//[^\n]*", "", raw)
raw = re.sub(r",(\s*[}\]])", r"\1", raw)
try:
    policy = json.loads(raw)
except Exception as e:
    print(f"Could not parse ACL: {e}", file=sys.stderr)
    sys.exit(1)

problems = []
owners = policy.get("tagOwners", {})
for tag in (service_host_tag, cursor_cloud_tag):
    if tag not in owners:
        problems.append(f"tagOwners missing {tag}")

grants = policy.get("grants", []) or policy.get("acls", [])
friend_granted = set()
cursor_grants = []
for grant in grants:
    sources = set(grant.get("src", []))
    destinations = set(grant.get("dst", []))
    ports = set(grant.get("ip", []))
    if "group:friends" in sources and "tcp:443" in ports:
        friend_granted.update(destinations)
    if cursor_cloud_tag in sources:
        cursor_grants.append((sources, destinations, ports))

for service in friend_services:
    if service not in friend_granted:
        problems.append(f"group:friends has no tcp:443 grant to {service}")

expected_cursor_grant = (
    {cursor_cloud_tag},
    {stockfish_service},
    {"tcp:8096"},
)
if cursor_grants != [expected_cursor_grant]:
    problems.append(
        f"{cursor_cloud_tag} must have exactly one grant: "
        f"{stockfish_service} on tcp:8096"
    )

required_accept = f"{stockfish_service}:8096"
required_denies = {
    f"{stockfish_service}:443",
    "svc:authentik:443",
    "svc:pirate-radio:443",
    f"{service_host_tag}:8096",
}
test_found = False
for test in policy.get("tests", []):
    if test.get("src") != cursor_cloud_tag:
        continue
    accepts = set(test.get("accept", []))
    denies = set(test.get("deny", []))
    if required_accept in accepts and required_denies <= denies:
        test_found = True
        break
if not test_found:
    problems.append(f"policy tests do not enforce the {cursor_cloud_tag} boundary")

if problems:
    print("ACL check FAILED:")
    for p in problems:
        print(f"  - {p}")
    sys.exit(1)
print("ACL check OK:")
print(f"  tagOwners has {service_host_tag} and {cursor_cloud_tag}")
print(f"  group:friends can reach {', '.join(friend_services)} on tcp:443")
print(f"  {cursor_cloud_tag} can reach only {stockfish_service} on tcp:8096")
print(f"  policy tests enforce positive and negative {cursor_cloud_tag} access")
PY
    ;;
esac
