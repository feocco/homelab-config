#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BASE_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
NAMES_FILE=""
STRICT="false"

source "${SCRIPT_DIR}/lib-service-secrets"

usage() {
  cat <<'EOF2'
Usage:
  check-declared-secrets-set --names-file FILE [--base-dir DIR] [--strict]

Compares every secret declared in service-secrets.yaml
(<SERVICE_PREFIX>__<KEY>) with the GitHub Actions secret names that actually
exist, one name per line in FILE. Produce FILE with:

  gh secret list -R feocco/homelab-config --json name -q '.[].name' > names.txt

Reads names only; never secret values. Prints one line per declared secret
that has no Actions secret. Exits 1 with --strict when any are missing, so a
PR that declares a secret before its value is set can be held back.
EOF2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --names-file) NAMES_FILE="${2:?--names-file requires a value}"; shift 2 ;;
    --base-dir) BASE_DIR="${2:?--base-dir requires a value}"; shift 2 ;;
    --strict) STRICT="true"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done

[[ -n "${NAMES_FILE}" && -f "${NAMES_FILE}" ]] || { usage >&2; exit 2; }
MANIFEST_FILE="$(service_secret_manifest "${BASE_DIR}")"

missing=0
while IFS= read -r name; do
  [[ -n "${name}" ]] || continue
  if ! grep -qxF "${name}" "${NAMES_FILE}"; then
    echo "Declared in service-secrets.yaml but not set as an Actions secret: ${name}"
    if [[ -n "${GITHUB_ACTIONS:-}" ]]; then
      echo "::warning title=Declared secret not set::${name}; its service will not deploy until it is set."
    fi
    missing=$((missing + 1))
  fi
done < <(service_secret_prefixed_names "${MANIFEST_FILE}" | sort -u)

if [[ "${missing}" -eq 0 ]]; then
  echo "All declared service secrets exist as Actions secrets."
  exit 0
fi
echo "${missing} declared secret(s) missing."
[[ "${STRICT}" == "true" ]] && exit 1
exit 0
