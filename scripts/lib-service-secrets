#!/bin/bash

service_secret_manifest() {
  local base_dir="$1"
  printf '%s/service-secrets.yaml' "${base_dir}"
}

service_secret_services_file() {
  local base_dir="$1"
  local host="${2:-}"

  if [[ -n "${host}" && -f "${base_dir}/hosts/${host}/services.yaml" ]]; then
    printf '%s/hosts/%s/services.yaml' "${base_dir}" "${host}"
    return 0
  fi

  printf '%s/services.yaml' "${base_dir}"
}

service_secret_host_names() {
  local base_dir="$1"

  if [[ -d "${base_dir}/hosts" ]]; then
    find "${base_dir}/hosts" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort
    return 0
  fi

  printf 'nasfeo\n'
}

service_secret_host_deploy_base_dir() {
  local services_file="$1"
  awk '
    /^host:[[:space:]]*$/ {
      in_host=1
      next
    }
    in_host && /^services:[[:space:]]*$/ {
      in_host=0
      next
    }
    in_host && /^  deploy_base_dir:/ {
      print $2
      exit
    }
  ' "${services_file}"
}

service_secret_expand_path() {
  local path="$1"

  case "${path}" in
    '${HOME}'/*)
      printf '%s/%s' "${HOME}" "${path#'${HOME}'/}"
      ;;
    '$HOME'/*)
      printf '%s/%s' "${HOME}" "${path#'$HOME'/}"
      ;;
    '~'/*)
      printf '%s/%s' "${HOME}" "${path#'~'/}"
      ;;
    *)
      printf '%s' "${path}"
      ;;
  esac
}

service_secret_prefix() {
  printf '%s' "$1" | tr '[:lower:]' '[:upper:]' | tr -c '[:alnum:]' '_'
}

service_secret_entries() {
  local manifest="$1"
  awk '
    /^services:[[:space:]]*$/ {
      in_services=1
      next
    }
    in_services && /^  [^[:space:]].*:[[:space:]]*$/ {
      service=$1
      sub(/:$/, "", service)
      in_env=0
      next
    }
    in_services && /^    env:[[:space:]]*$/ {
      in_env=1
      next
    }
    in_services && /^    [^[:space:]].*:[[:space:]]*$/ {
      in_env=0
      next
    }
    in_env && /^      - / {
      key=$2
      if (key !~ /^[A-Za-z_][A-Za-z0-9_]*$/) {
        printf "Invalid variable name in %s: %s\n", FILENAME, key > "/dev/stderr"
        exit 2
      }
      print service "|" key
    }
  ' "${manifest}"
}

service_secret_services() {
  local manifest="$1"
  service_secret_entries "${manifest}" | awk -F'|' '{ print $1 }' | sort -u
}

service_secret_service_names() {
  local services_file="$1"
  awk '
    /^services:[[:space:]]*$/ {
      in_services=1
      next
    }
    in_services && /^  [^[:space:]].*:[[:space:]]*$/ {
      name=$1
      sub(/:$/, "", name)
      print name
    }
  ' "${services_file}"
}

service_secret_enabled_service_names() {
  local services_file="$1"
  awk '
    function emit() {
      if (name != "" && enabled != "false") {
        print name
      }
    }
    /^services:[[:space:]]*$/ {
      in_services=1
      next
    }
    in_services && /^  [^[:space:]].*:[[:space:]]*$/ {
      emit()
      name=$1
      sub(/:$/, "", name)
      enabled="true"
      next
    }
    in_services && /^    enabled:/ {
      enabled=$2
      next
    }
    END {
      emit()
    }
  ' "${services_file}" | sort
}

service_secret_keys() {
  local manifest="$1"
  local service="$2"
  service_secret_entries "${manifest}" | awk -F'|' -v service="${service}" '$1 == service { print $2 }'
}

service_secret_prefixed_names() {
  local manifest="$1"
  while IFS='|' read -r service key; do
    [[ -n "${service}" ]] || continue
    printf '%s__%s\n' "$(service_secret_prefix "${service}")" "${key}"
  done < <(service_secret_entries "${manifest}")
}

service_secret_service_path() {
  local services_file="$1"
  local service="$2"
  awk -v service="${service}" '
    /^services:[[:space:]]*$/ {
      in_services=1
      next
    }
    in_services && /^  [^[:space:]].*:[[:space:]]*$/ {
      name=$1
      sub(/:$/, "", name)
      active=(name == service)
      next
    }
    active && /^    path:/ {
      print $2
      exit
    }
  ' "${services_file}"
}

service_secret_config_file() {
  local base_dir="$1"
  local services_file="$2"
  local service="$3"
  local service_path

  service_path="$(service_secret_service_path "${services_file}" "${service}")"
  [[ -n "${service_path}" ]] || return 1
  printf '%s/%s/.env.config' "${base_dir}" "${service_path}"
}

service_secret_host_config_file() {
  local base_dir="$1"
  local host="$2"
  local service="$3"

  printf '%s/hosts/%s/%s.env.config' "${base_dir}" "${host}" "${service}"
}

service_secret_config_services() {
  local base_dir="$1"
  local services_file="$2"
  local service config_file

  while IFS= read -r service; do
    [[ -n "${service}" ]] || continue
    config_file="$(service_secret_config_file "${base_dir}" "${services_file}" "${service}")"
    [[ -f "${config_file}" ]] && printf '%s\n' "${service}"
  done < <(service_secret_service_names "${services_file}")
}

service_secret_runtime_services() {
  local base_dir="$1"
  local services_file="$2"
  local manifest="$3"

  service_secret_enabled_service_names "${services_file}"
}

service_secret_all_runtime_services() {
  local base_dir="$1"
  local manifest="$2"
  local host services_file

  {
    service_secret_services "${manifest}"
    while IFS= read -r host; do
      [[ -n "${host}" ]] || continue
      services_file="$(service_secret_services_file "${base_dir}" "${host}")"
      service_secret_config_services "${base_dir}" "${services_file}"
    done < <(service_secret_host_names "${base_dir}")
    if [[ -d "${base_dir}/hosts" ]]; then
      find "${base_dir}/hosts" -name '*.env.config' -type f -exec basename {} .env.config \;
    fi
  } | sort -u
}

service_secret_env_keys() {
  local env_file="$1"
  while IFS= read -r line || [[ -n "${line}" ]]; do
    line="${line%$'\r'}"
    [[ -n "${line}" ]] || continue
    [[ "${line}" != \#* ]] || continue
    [[ "${line}" == *=* ]] || continue
    key="${line%%=*}"
    key="${key#export }"
    if [[ ! "${key}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
      echo "Invalid variable name in ${env_file}: ${key}" >&2
      return 2
    fi
    printf '%s\n' "${key}"
  done < "${env_file}"
}

service_secret_env_value() {
  local env_file="$1"
  local wanted="$2"
  local line key value found
  found="false"

  while IFS= read -r line || [[ -n "${line}" ]]; do
    line="${line%$'\r'}"
    [[ -n "${line}" ]] || continue
    [[ "${line}" != \#* ]] || continue
    [[ "${line}" == *=* ]] || continue
    key="${line%%=*}"
    key="${key#export }"
    value="${line#*=}"
    if [[ "${key}" == "${wanted}" ]]; then
      found="true"
      printf '%s' "${value}"
    fi
  done < "${env_file}"

  [[ "${found}" == "true" ]]
}
