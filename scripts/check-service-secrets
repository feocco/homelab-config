#!/bin/bash
set -euo pipefail

BASE_DIR="$(pwd)"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "${SCRIPT_DIR}/lib-service-secrets"

usage() {
  cat <<'EOF'
Usage:
  check-service-secrets [--base-dir DIR]

Validates service-secrets.yaml, shared .env.config files, host .env.config
overrides, service .env.example files, and generated workflow secret mappings.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --base-dir)
      BASE_DIR="${2:?--base-dir requires a value}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

MANIFEST_FILE="$(service_secret_manifest "${BASE_DIR}")"

if [[ ! -f "${MANIFEST_FILE}" ]]; then
  echo "Missing ${MANIFEST_FILE}" >&2
  exit 2
fi

shared_service_path() {
  local service="$1"
  local host services_file path

  while IFS= read -r host; do
    [[ -n "${host}" ]] || continue
    services_file="$(service_secret_services_file "${BASE_DIR}" "${host}")"
    path="$(service_secret_service_path "${services_file}" "${service}")"
    if [[ -n "${path}" ]]; then
      printf '%s\n' "${path}"
      return 0
    fi
  done < <(service_secret_host_names "${BASE_DIR}")

  return 1
}

while IFS= read -r service; do
  [[ -n "${service}" ]] || continue
  service_path="$(shared_service_path "${service}" || true)"
  if [[ -z "${service_path}" ]]; then
    echo "Secret/config manifest references unsupported service: ${service}" >&2
    exit 2
  fi

  example_file="${BASE_DIR}/${service_path}/.env.example"
  shared_config_file="${BASE_DIR}/${service_path}/.env.config"
  if [[ ! -f "${example_file}" ]]; then
    echo "Missing ${example_file}" >&2
    exit 2
  fi

  manifest_keys="$(mktemp)"
  config_keys="$(mktemp)"
  expected_keys="$(mktemp)"
  example_keys="$(mktemp)"
  duplicate_keys="$(mktemp)"
  trap 'rm -f "${manifest_keys}" "${config_keys}" "${expected_keys}" "${example_keys}" "${duplicate_keys}"' EXIT

  service_secret_keys "${MANIFEST_FILE}" "${service}" | sort > "${manifest_keys}"
  if [[ -f "${shared_config_file}" ]]; then
    service_secret_env_keys "${shared_config_file}" >> "${config_keys}"
  fi
  while IFS= read -r host; do
    host_config_file="$(service_secret_host_config_file "${BASE_DIR}" "${host}" "${service}")"
    [[ -f "${host_config_file}" ]] && service_secret_env_keys "${host_config_file}" >> "${config_keys}"
  done < <(service_secret_host_names "${BASE_DIR}")
  sort -u "${config_keys}" -o "${config_keys}"

  comm -12 "${manifest_keys}" "${config_keys}" > "${duplicate_keys}"
  if [[ -s "${duplicate_keys}" ]]; then
    echo "${service} defines the same key in service-secrets.yaml and tracked env config:" >&2
    sed 's/^/  /' "${duplicate_keys}" >&2
    exit 1
  fi
  cat "${manifest_keys}" "${config_keys}" | sort -u > "${expected_keys}"
  service_secret_env_keys "${example_file}" | sort -u > "${example_keys}"
  if ! diff -u "${expected_keys}" "${example_keys}"; then
    echo "${service} env keys differ between service-secrets.yaml, tracked env config, and ${example_file}" >&2
    exit 1
  fi
  rm -f "${manifest_keys}" "${config_keys}" "${expected_keys}" "${example_keys}" "${duplicate_keys}"
  trap - EXIT
done < <(service_secret_all_runtime_services "${BASE_DIR}" "${MANIFEST_FILE}")

"${SCRIPT_DIR}/generate-service-secret-workflow-env" --base-dir "${BASE_DIR}" --check

workflow_file="${BASE_DIR}/.github/workflows/deploy.yml"
if [[ -f "${workflow_file}" ]]; then
  while IFS= read -r service; do
    [[ -n "${service}" ]] || continue
    enabled_anywhere="false"
    while IFS= read -r host; do
      services_file="$(service_secret_services_file "${BASE_DIR}" "${host}")"
      if service_secret_enabled_service_names "${services_file}" | grep -qxF "${service}"; then
        enabled_anywhere="true"
      fi
    done < <(service_secret_host_names "${BASE_DIR}")
    if [[ "${enabled_anywhere}" == "false" ]]; then
      while IFS= read -r key; do
        secret_name="$(service_secret_prefix "${service}")__${key}"
        if grep -q "${secret_name}:" "${workflow_file}"; then
          echo "Disabled service secret ${secret_name} is still present in ${workflow_file}" >&2
          exit 1
        fi
      done < <(service_secret_keys "${MANIFEST_FILE}" "${service}")
    fi
  done < <(service_secret_services "${MANIFEST_FILE}")
fi
echo "Service secret checks passed."
