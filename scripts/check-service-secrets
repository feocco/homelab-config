#!/bin/bash
set -euo pipefail

BASE_DIR="$(pwd)"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "${SCRIPT_DIR}/lib-service-secrets"

usage() {
  cat <<'EOF'
Usage:
  check-service-secrets [--base-dir DIR]

Validates service-secrets.yaml, service .env.example files, and generated
workflow secret mappings.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --base-dir)
      BASE_DIR="${2:?--base-dir requires a value}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

SERVICES_FILE="${BASE_DIR}/services.yaml"
MANIFEST_FILE="$(service_secret_manifest "${BASE_DIR}")"

if [[ ! -f "${SERVICES_FILE}" ]]; then
  echo "Missing ${SERVICES_FILE}" >&2
  exit 2
fi

if [[ ! -f "${MANIFEST_FILE}" ]]; then
  echo "Missing ${MANIFEST_FILE}" >&2
  exit 2
fi

while IFS= read -r service; do
  [[ -n "${service}" ]] || continue
  service_path="$(service_secret_service_path "${SERVICES_FILE}" "${service}")"
  if [[ -z "${service_path}" ]]; then
    echo "Secret manifest references unsupported service: ${service}" >&2
    exit 2
  fi

  example_file="${BASE_DIR}/${service_path}/.env.example"
  if [[ ! -f "${example_file}" ]]; then
    echo "Missing ${example_file}" >&2
    exit 2
  fi

  manifest_keys="$(mktemp)"
  example_keys="$(mktemp)"
  trap 'rm -f "${manifest_keys}" "${example_keys}"' EXIT
  service_secret_keys "${MANIFEST_FILE}" "${service}" | sort > "${manifest_keys}"
  service_secret_env_keys "${example_file}" | sort > "${example_keys}"
  if ! diff -u "${manifest_keys}" "${example_keys}"; then
    echo "${service} secrets differ between service-secrets.yaml and ${example_file}" >&2
    exit 1
  fi
  rm -f "${manifest_keys}" "${example_keys}"
  trap - EXIT
done < <(service_secret_services "${MANIFEST_FILE}")

"${SCRIPT_DIR}/generate-service-secret-workflow-env" --base-dir "${BASE_DIR}" --check
echo "Service secret checks passed."
