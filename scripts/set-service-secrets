#!/bin/bash
set -euo pipefail

BASE_DIR="$(pwd)"
ENV_FILE=""
REPO=""
DRY_RUN="false"
DISPATCH="false"
SERVICE=""
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "${SCRIPT_DIR}/lib-service-secrets"

usage() {
  cat <<'EOF'
Usage:
  set-service-secrets <service> [--base-dir DIR] [--env-file FILE] [--repo OWNER/REPO] [--dry-run] [--dispatch]

Reads service-secrets.yaml to find required variable names, reads values from
<service>/.env, and stores them as GitHub Actions secrets named:

  <SERVICE_PREFIX>__<VARIABLE_NAME>

Example:
  hello-nas/.env key HELLO_NAS_MESSAGE becomes HELLO_NAS__HELLO_NAS_MESSAGE.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --base-dir)
      BASE_DIR="${2:?--base-dir requires a value}"
      shift 2
      ;;
    --env-file)
      ENV_FILE="${2:?--env-file requires a value}"
      shift 2
      ;;
    --repo)
      REPO="${2:?--repo requires a value}"
      shift 2
      ;;
    --dry-run)
      DRY_RUN="true"
      shift
      ;;
    --dispatch)
      DISPATCH="true"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      SERVICE="$1"
      shift
      ;;
  esac
done

if [[ -z "${SERVICE}" ]]; then
  usage >&2
  exit 2
fi

SERVICES_FILE="${BASE_DIR}/services.yaml"
MANIFEST_FILE="$(service_secret_manifest "${BASE_DIR}")"
if [[ ! -f "${SERVICES_FILE}" ]]; then
  echo "Missing ${SERVICES_FILE}" >&2
  exit 2
fi

if [[ ! -f "${MANIFEST_FILE}" ]]; then
  echo "Missing ${MANIFEST_FILE}" >&2
  exit 2
fi

SERVICE_PATH="$(service_secret_service_path "${SERVICES_FILE}" "${SERVICE}")"
if [[ -z "${SERVICE_PATH}" ]]; then
  echo "Unsupported service: ${SERVICE}" >&2
  exit 2
fi

ENV_FILE="${ENV_FILE:-${BASE_DIR}/${SERVICE_PATH}/.env}"
PREFIX="$(service_secret_prefix "${SERVICE}")"

if [[ -z "${REPO}" ]]; then
  REPO="$(gh repo view --json nameWithOwner --jq .nameWithOwner)"
fi

if [[ ! -f "${ENV_FILE}" ]]; then
  echo "Missing ${ENV_FILE}" >&2
  exit 2
fi

if [[ -z "$(service_secret_keys "${MANIFEST_FILE}" "${SERVICE}")" ]]; then
  echo "No secrets listed for ${SERVICE} in ${MANIFEST_FILE}" >&2
  exit 2
fi

while IFS= read -r key; do
  secret_name="${PREFIX}__${key}"
  if ! value="$(service_secret_env_value "${ENV_FILE}" "${key}")"; then
    echo "Missing ${key} in ${ENV_FILE}" >&2
    exit 2
  fi

  if [[ "${DRY_RUN}" == "true" ]]; then
    echo "Would set ${secret_name} from ${ENV_FILE} key ${key}"
    continue
  fi

  printf '%s' "${value}" | gh secret set "${secret_name}" --repo "${REPO}"
  echo "Set ${secret_name} from ${ENV_FILE} key ${key}"
done < <(service_secret_keys "${MANIFEST_FILE}" "${SERVICE}")

if [[ "${DISPATCH}" == "true" && "${DRY_RUN}" != "true" ]]; then
  gh workflow run Deploy --repo "${REPO}" -f "service=${SERVICE}"
  echo "Dispatched Deploy workflow for ${SERVICE}"
fi
