#!/bin/bash
set -euo pipefail

BASE_DIR="$(pwd)"
ENV_FILE=""
REPO=""
DRY_RUN="false"
SERVICE=""

usage() {
  cat <<'EOF'
Usage:
  set-service-secrets <service> [--base-dir DIR] [--env-file FILE] [--repo OWNER/REPO] [--dry-run]

Reads <service>/.env.example to find required variable names, reads values from
<service>/.env, and stores them as GitHub Actions secrets named:

  <SERVICE_PREFIX>__<VARIABLE_NAME>

Example:
  hello-nas/.env key HELLO_NAS_MESSAGE becomes HELLO_NAS__HELLO_NAS_MESSAGE.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --base-dir)
      BASE_DIR="${2:?--base-dir requires a value}"
      shift 2
      ;;
    --env-file)
      ENV_FILE="${2:?--env-file requires a value}"
      shift 2
      ;;
    --repo)
      REPO="${2:?--repo requires a value}"
      shift 2
      ;;
    --dry-run)
      DRY_RUN="true"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      SERVICE="$1"
      shift
      ;;
  esac
done

if [[ -z "${SERVICE}" ]]; then
  usage >&2
  exit 2
fi

SERVICES_FILE="${BASE_DIR}/services.yaml"
if [[ ! -f "${SERVICES_FILE}" ]]; then
  echo "Missing ${SERVICES_FILE}" >&2
  exit 2
fi

service_path() {
  awk -v service="${SERVICE}" '
    /^services:[[:space:]]*$/ {
      in_services=1
      next
    }
    in_services && /^  [^[:space:]].*:[[:space:]]*$/ {
      name=$1
      sub(/:$/, "", name)
      active=(name == service)
      next
    }
    active && /^    path:/ {
      print $2
      exit
    }
  ' "${SERVICES_FILE}"
}

service_prefix() {
  printf '%s' "$1" | tr '[:lower:]' '[:upper:]' | tr -c '[:alnum:]' '_'
}

example_keys() {
  local example_file="$1"
  while IFS= read -r line || [[ -n "${line}" ]]; do
    line="${line%$'\r'}"
    [[ -n "${line}" ]] || continue
    [[ "${line}" != \#* ]] || continue
    [[ "${line}" == *=* ]] || continue
    key="${line%%=*}"
    key="${key#export }"
    if [[ ! "${key}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
      echo "Invalid variable name in ${example_file}: ${key}" >&2
      exit 2
    fi
    printf '%s\n' "${key}"
  done < "${example_file}"
}

env_value() {
  local env_file="$1"
  local wanted="$2"
  local line key value found
  found="false"

  while IFS= read -r line || [[ -n "${line}" ]]; do
    line="${line%$'\r'}"
    [[ -n "${line}" ]] || continue
    [[ "${line}" != \#* ]] || continue
    [[ "${line}" == *=* ]] || continue
    key="${line%%=*}"
    key="${key#export }"
    value="${line#*=}"
    if [[ "${key}" == "${wanted}" ]]; then
      found="true"
      printf '%s' "${value}"
    fi
  done < "${env_file}"

  [[ "${found}" == "true" ]]
}

SERVICE_PATH="$(service_path)"
if [[ -z "${SERVICE_PATH}" ]]; then
  echo "Unsupported service: ${SERVICE}" >&2
  exit 2
fi

EXAMPLE_FILE="${BASE_DIR}/${SERVICE_PATH}/.env.example"
ENV_FILE="${ENV_FILE:-${BASE_DIR}/${SERVICE_PATH}/.env}"
PREFIX="$(service_prefix "${SERVICE}")"

if [[ -z "${REPO}" ]]; then
  REPO="$(gh repo view --json nameWithOwner --jq .nameWithOwner)"
fi

if [[ ! -f "${EXAMPLE_FILE}" ]]; then
  echo "Missing ${EXAMPLE_FILE}" >&2
  exit 2
fi

if [[ ! -f "${ENV_FILE}" ]]; then
  echo "Missing ${ENV_FILE}" >&2
  exit 2
fi

while IFS= read -r key; do
  secret_name="${PREFIX}__${key}"
  if ! value="$(env_value "${ENV_FILE}" "${key}")"; then
    echo "Missing ${key} in ${ENV_FILE}" >&2
    exit 2
  fi

  if [[ "${DRY_RUN}" == "true" ]]; then
    echo "Would set ${secret_name} from ${ENV_FILE} key ${key}"
    continue
  fi

  printf '%s' "${value}" | gh secret set "${secret_name}" --repo "${REPO}"
  echo "Set ${secret_name} from ${ENV_FILE} key ${key}"
done < <(example_keys "${EXAMPLE_FILE}")

