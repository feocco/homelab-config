# Store this on the NAS at /volume1/docker/homelab-secrets/github-runner.env.
# GitHub App auth is the default for the NAS Dockerized runner.
# APP_PRIVATE_KEY is one line with literal \n separators.
APP_ID=replace_me
APP_LOGIN=feocco
APP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----
